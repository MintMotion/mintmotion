#: src/mintmotion:103
msgid "Fill the screen (crops the excess)"
msgstr "Rellenar la pantalla (recorta lo que sobre)"

#: src/mintmotion:104
msgid "Fit without cropping (black bars)"
msgstr "Ajustar sin recortar (bandas negras)"

#: src/mintmotion:105
msgid "Stretch (may distort)"
msgstr "Estirar (puede deformar)"

#: src/mintmotion:106
msgid "High (recommended)"
msgstr "Alta (recomendada)"

#: src/mintmotion:107
msgid "Maximum (more work for the GPU)"
msgstr "Máxima (más trabajo para la GPU)"

#: src/mintmotion:108
msgid "Saver (basic scaling)"
msgstr "Ahorro (escalado básico)"

#: src/mintmotion:111
msgid "playing"
msgstr "reproduciendo"

#: src/mintmotion:111
msgid "paused"
msgstr "pausado"

#: src/mintmotion:111
msgid "sleeping"
msgstr "dormido"

#: src/mintmotion:112
msgid "error"
msgstr "error"

#: src/mintmotion:112
msgid "stopped"
msgstr "detenido"

#: src/mintmotion:677
msgid "Video as desktop background"
msgstr "Vídeo como fondo de escritorio"

#: src/mintmotion:700
msgid "Choose video…"
msgstr "Elegir vídeo…"

#: src/mintmotion:711
msgid "Optimize for my screen"
msgstr "Optimizar para mi pantalla"

#: src/mintmotion:713
msgid ""
"Creates a copy of the video at the exact resolution of your screen, at 30 "
"fps at most and without sound: maximum sharpness and minimum resource usage. "
"The original is not touched."
msgstr ""
"Crea una copia del vídeo a la resolución exacta de tu pantalla, a 30 fps "
"como máximo y sin sonido: máxima nitidez y el mínimo consumo. El original no "
"se toca."

#: src/mintmotion:718
msgid "Cancel"
msgstr "Cancelar"

#: src/mintmotion:736
msgid "Screen fit"
msgstr "Ajuste a la pantalla"

#: src/mintmotion:737
msgid "Scaling quality"
msgstr "Calidad de escalado"

#: src/mintmotion:738
msgid "Pause when the desktop is fully covered"
msgstr "Pausar cuando el escritorio queda tapado por completo"

#: src/mintmotion:739
msgid "Hardware decoding"
msgstr "Decodificación por hardware"

#: src/mintmotion:753
#, python-brace-format
msgid ""
"Resource usage of {app} (the mpv player and, in Xfce, its supervisor) "
"compared with the whole computer. The work the desktop does to compose the "
"video on screen cannot be separated from the desktop itself, so it is not "
"included."
msgstr ""
"Consumo de {app} (el reproductor mpv y, en Xfce, su supervisor) frente al "
"total del equipo. El trabajo que hace el escritorio para componer el vídeo "
"en pantalla no se puede separar del propio escritorio, así que no está "
"incluido."

#: src/mintmotion:783
msgid "Uninstall…"
msgstr "Desinstalar…"

#: src/mintmotion:786
#, python-brace-format
msgid ""
"Removes {app} and all its settings from the computer. Your videos are not "
"touched."
msgstr ""
"Quita {app} y toda su configuración del equipo. Tus vídeos no se tocan."

#: src/mintmotion:789
msgid "Remove video"
msgstr "Quitar vídeo"

#: src/mintmotion:791
msgid ""
"Stops playing the video and goes back to your static desktop background."
msgstr ""
"Deja de reproducir el vídeo y vuelve a tu fondo de escritorio estático."

#: src/mintmotion:793
msgid "Apply"
msgstr "Aplicar"

#: src/mintmotion:795
msgid "Sets the video as background with these options."
msgstr "Pone el vídeo de fondo con estas opciones."

#: src/mintmotion:805
#, python-brace-format
msgid "{app} · by {author}"
msgstr "{app} · by {author}"

#: src/mintmotion:834
msgid ""
"You are in a Wayland session. The video background only works in the X11 "
"session (the default one in Linux Mint and LMDE)."
msgstr ""
"Estás en una sesión Wayland. El fondo de vídeo solo funciona en la sesión "
"X11 (la normal en Linux Mint y LMDE)."

#: src/mintmotion:837
#, python-brace-format
msgid "{app} needs the Cinnamon or Xfce desktop."
msgstr "{app} necesita el escritorio Cinnamon o Xfce."

#: src/mintmotion:839 src/mintmotion:1016 src/mintmotion:1358
#, python-brace-format
msgid "The Xfce part of {app} is not installed (mintmotion-xfce is missing)."
msgstr "La parte de {app} para Xfce no está instalada (falta mintmotion-xfce)."

#: src/mintmotion:842
msgid "mpv is missing: install it with “sudo apt install mpv”."
msgstr "Falta mpv: instálalo con «sudo apt install mpv»."

#: src/mintmotion:880
msgid "_Close"
msgstr "_Cerrar"

#: src/mintmotion:891
msgid "No video selected"
msgstr "Ningún vídeo seleccionado"

#: src/mintmotion:899
msgid "The file no longer exists."
msgstr "El archivo ya no existe."

#: src/mintmotion:910
msgid "Not recognized as a video."
msgstr "No se reconoce como vídeo."

#: src/mintmotion:929
#, python-brace-format
msgid "Ideal for your screen ({w}×{h})."
msgstr "Ideal para tu pantalla ({w}×{h})."

#: src/mintmotion:934
#, python-brace-format
msgid "your screen is {w}×{h}"
msgstr "tu pantalla es de {w}×{h}"

#: src/mintmotion:936
msgid "more than 30 fps costs more without being noticeable in a background"
msgstr "más de 30 fps gasta más sin que se note en un fondo"

#: src/mintmotion:938
msgid "H.264 is the format that any graphics card decodes best"
msgstr "H.264 es el formato que mejor decodifica cualquier gráfica"

#: src/mintmotion:939
#, python-brace-format
msgid "Can be optimized: {reasons}."
msgstr "Se puede optimizar: {reasons}."

#: src/mintmotion:964
msgid "Choose a video"
msgstr "Elige un vídeo"

#: src/mintmotion:966 src/mintmotion:1036 src/mintmotion:1042
#: src/mintmotion:1072
msgid "_Cancel"
msgstr "_Cancelar"

#: src/mintmotion:966 src/mintmotion:1042
msgid "_Open"
msgstr "_Abrir"

#: src/mintmotion:969
msgid "Videos"
msgstr "Vídeos"

#: src/mintmotion:976
msgid "All files"
msgstr "Todos los archivos"

#: src/mintmotion:1015
msgid "The video could not be started."
msgstr "No se pudo poner el vídeo."

#: src/mintmotion:1020
msgid "Cinnamon was not found."
msgstr "No se encontró Cinnamon."

#: src/mintmotion:1021
#, python-brace-format
msgid "{app} works as an extension of the Cinnamon desktop."
msgstr "{app} funciona como extensión del escritorio Cinnamon."

#: src/mintmotion:1034
msgid "Your previous desktop background no longer exists"
msgstr "Tu fondo de escritorio anterior ya no existe"

#: src/mintmotion:1035
msgid "Choose an image to set as desktop background."
msgstr "Elige una imagen para dejarla como fondo de escritorio."

#: src/mintmotion:1037
msgid "_Choose image…"
msgstr "_Elegir imagen…"

#: src/mintmotion:1040
msgid "Choose a background image"
msgstr "Elige una imagen de fondo"

#: src/mintmotion:1044
msgid "Images"
msgstr "Imágenes"

#: src/mintmotion:1068
#, python-brace-format
msgid "Uninstall {app}?"
msgstr "¿Desinstalar {app}?"

#: src/mintmotion:1069
msgid ""
"The program and all its settings will be removed. The desktop will go back "
"to a static background."
msgstr ""
"Se quitarán el programa y toda su configuración. El escritorio volverá a "
"tener un fondo estático."

#: src/mintmotion:1071
msgid "Your videos will not be touched."
msgstr "Tus vídeos no se tocarán."

#: src/mintmotion:1073
msgid "_Uninstall"
msgstr "_Desinstalar"

#: src/mintmotion:1078
#, python-brace-format
msgid "{app} is not installed as a package"
msgstr "{app} no está instalado como paquete"

#: src/mintmotion:1079
msgid ""
"It seems to be installed from the source code. Uninstall it from that folder "
"with:"
msgstr ""
"Parece instalado desde el código fuente. Desinstálalo desde esa carpeta con:"

#: src/mintmotion:1083
msgid "pkexec is missing"
msgstr "Falta pkexec"

#: src/mintmotion:1084
msgid ""
"Without pkexec I cannot ask for your password. Uninstall it from a terminal "
"with:"
msgstr ""
"Sin pkexec no puedo pedirte la contraseña. Desinstálalo desde una terminal "
"con:"

#: src/mintmotion:1094
#, python-brace-format
msgid "What should I do with the videos that {app} created?"
msgstr "¿Qué hago con los vídeos que creó {app}?"

#: src/mintmotion:1095
#, python-brace-format
msgid "“Optimize for my screen” created <b>{n} video</b> ({size}) in"
msgid_plural "“Optimize for my screen” created <b>{n} videos</b> ({size}) in"
msgstr[0] ""
"Con «Optimizar para mi pantalla» se creó <b>{n} vídeo</b> ({size}) en"
msgstr[1] ""
"Con «Optimizar para mi pantalla» se crearon <b>{n} vídeos</b> ({size}) en"

#: src/mintmotion:1099
msgid "_Keep them"
msgstr "_Conservarlos"

#: src/mintmotion:1100
msgid "_Delete them"
msgstr "_Borrarlos"

#: src/mintmotion:1110
msgid "Uninstalling… enter your password if asked."
msgstr "Desinstalando… introduce tu contraseña si te la pide."

#: src/mintmotion:1129
msgid "You cancelled the password prompt."
msgstr "Has cancelado la contraseña."

#: src/mintmotion:1138
#, python-brace-format
msgid "The optimized videos are still in {folder}."
msgstr "Los vídeos optimizados siguen en {folder}."

#: src/mintmotion:1140
#, python-brace-format
msgid "{app} has been uninstalled"
msgstr "{app} se ha desinstalado"

#: src/mintmotion:1141
msgid "Nothing of the program remains on the computer."
msgstr "No queda nada del programa en el equipo."

#: src/mintmotion:1147
msgid "It was not uninstalled"
msgstr "No se ha desinstalado"

#: src/mintmotion:1170
msgid "No video: your static desktop background is shown."
msgstr "Sin vídeo: se ve tu fondo de escritorio estático."

#: src/mintmotion:1172
msgid "Playing on the desktop."
msgstr "Reproduciéndose en el escritorio."

#: src/mintmotion:1175
msgid "Paused: the desktop is covered (it barely uses CPU)."
msgstr "En pausa: el escritorio está tapado (apenas usa CPU)."

#: src/mintmotion:1178
msgid ""
"Sleeping: the desktop has been covered for a while and the player was closed "
"to free its memory. When uncovered, it continues where it was."
msgstr ""
"En reposo: el escritorio lleva rato tapado y el reproductor se ha cerrado "
"para liberar la memoria. Al destaparlo sigue donde iba."

#: src/mintmotion:1182
#, python-brace-format
msgid "The player has failed several times (check {log})."
msgstr "El reproductor ha fallado varias veces (revisa {log})."

#: src/mintmotion:1185
#, python-brace-format
msgid "Starting… (if this does not change, check {log})"
msgstr "Arrancando… (si no cambia, revisa {log})"

#: src/mintmotion:1188
msgid "There are changes not applied yet: press “Apply”."
msgstr "Hay cambios sin aplicar: pulsa «Aplicar»."

#: src/mintmotion:1190
msgid "Press “Apply” to set the video."
msgstr "Pulsa «Aplicar» para poner el vídeo."

#: src/mintmotion:1206
msgid "measuring…"
msgstr "midiendo…"

#: src/mintmotion:1212
#, no-python-format, python-brace-format
msgid "{total}% of total · {core}% of one core ({n} core)"
msgid_plural "{total}% of total · {core}% of one core ({n} cores)"
msgstr[0] "{total} % del total · {core} % de un núcleo ({n} núcleo)"
msgstr[1] "{total} % del total · {core} % de un núcleo ({n} núcleos)"

#: src/mintmotion:1218
#, no-python-format, python-brace-format
msgid "{used} of {total} · {pct}%"
msgstr "{used} de {total} · {pct} %"

#: src/mintmotion:1241 src/mintmotion:1257
#, no-python-format, python-brace-format
msgid "Optimizing… {pct}%"
msgstr "Optimizando… {pct} %"

#: src/mintmotion:1274
msgid "The video could not be optimized."
msgstr "No se pudo optimizar el vídeo."

#: src/mintmotion:1307
#, python-brace-format
msgid ""
"{app}: video as desktop background in Cinnamon and Xfce. Without arguments "
"it opens the settings window."
msgstr ""
"{app}: vídeo como fondo de escritorio en Cinnamon y Xfce. Sin argumentos "
"abre la ventana de configuración."

#: src/mintmotion:1309
msgid "video to use as background (it also enables it)"
msgstr "vídeo que se usará como fondo (y lo activa)"

#: src/mintmotion:1310
msgid "screen fit"
msgstr "ajuste a la pantalla"

#: src/mintmotion:1311
msgid "scaling quality"
msgstr "calidad de escalado"

#: src/mintmotion:1313
msgid "pause when the desktop is covered"
msgstr "pausar con el escritorio tapado"

#: src/mintmotion:1314
msgid "hardware decoding"
msgstr "decodificación por hardware"

#: src/mintmotion:1315
msgid "set the video as background"
msgstr "poner el vídeo de fondo"

#: src/mintmotion:1316
msgid "remove the video background"
msgstr "quitar el vídeo de fondo"

#: src/mintmotion:1317
msgid "show the status"
msgstr "mostrar el estado"

#: src/mintmotion:1324
#, python-brace-format
msgid "could not migrate the previous version: {error}"
msgstr "no se pudo migrar la versión anterior: {error}"

#: src/mintmotion:1336
#, python-brace-format
msgid "Does not exist: {path}"
msgstr "No existe: {path}"

#: src/mintmotion:1361
msgid "Cinnamon was not found (org.cinnamon schema)."
msgstr "No se encontró Cinnamon (esquema org.cinnamon)."

#: src/mintmotion:1364
msgid "yes"
msgstr "sí"

#: src/mintmotion:1364
msgid "no"
msgstr "no"

#: src/mintmotion:1366
#, python-brace-format
msgid "enabled: {value}"
msgstr "activado: {value}"

#: src/mintmotion:1367
#, python-brace-format
msgid "video: {value}"
msgstr "vídeo: {value}"

#: src/mintmotion:1367
msgid "(none)"
msgstr "(ninguno)"

#: src/mintmotion:1368
#, python-brace-format
msgid ""
"fit: {fit} · quality: {quality} · hardware: {hw} · pause when covered: "
"{pause}"
msgstr ""
"ajuste: {fit} · calidad: {quality} · hardware: {hw} · pausa al tapar: {pause}"

#: src/mintmotion:1371
#, python-brace-format
msgid "state: {value}"
msgstr "estado: {value}"
