#: src/mintmotion:103
msgid "Fill the screen (crops the excess)"
msgstr "Remplir l’écran (rogne le surplus)"

#: src/mintmotion:104
msgid "Fit without cropping (black bars)"
msgstr "Ajuster sans rogner (bandes noires)"

#: src/mintmotion:105
msgid "Stretch (may distort)"
msgstr "Étirer (peut déformer)"

#: src/mintmotion:106
msgid "High (recommended)"
msgstr "Haute (recommandée)"

#: src/mintmotion:107
msgid "Maximum (more work for the GPU)"
msgstr "Maximale (plus de travail pour le GPU)"

#: src/mintmotion:108
msgid "Saver (basic scaling)"
msgstr "Économie (mise à l’échelle simple)"

#: src/mintmotion:111
msgid "playing"
msgstr "lecture"

#: src/mintmotion:111
msgid "paused"
msgstr "en pause"

#: src/mintmotion:111
msgid "sleeping"
msgstr "en veille"

#: src/mintmotion:112
msgid "error"
msgstr "erreur"

#: src/mintmotion:112
msgid "stopped"
msgstr "arrêté"

#: src/mintmotion:677
msgid "Video as desktop background"
msgstr "Vidéo en fond d’écran"

#: src/mintmotion:700
msgid "Choose video…"
msgstr "Choisir une vidéo…"

#: src/mintmotion:711
msgid "Optimize for my screen"
msgstr "Optimiser pour mon écran"

#: src/mintmotion:713
msgid ""
"Creates a copy of the video at the exact resolution of your screen, at 30 "
"fps at most and without sound: maximum sharpness and minimum resource usage. "
"The original is not touched."
msgstr ""
"Crée une copie de la vidéo à la résolution exacte de votre écran, à 30 i/s "
"au maximum et sans son : netteté maximale et consommation minimale. "
"L’original n’est pas modifié."

#: src/mintmotion:718
msgid "Cancel"
msgstr "Annuler"

#: src/mintmotion:736
msgid "Screen fit"
msgstr "Adaptation à l’écran"

#: src/mintmotion:737
msgid "Scaling quality"
msgstr "Qualité de mise à l’échelle"

#: src/mintmotion:738
msgid "Pause when the desktop is fully covered"
msgstr "Mettre en pause quand le bureau est entièrement recouvert"

#: src/mintmotion:739
msgid "Hardware decoding"
msgstr "Décodage matériel"

#: src/mintmotion:753
#, python-brace-format
msgid ""
"Resource usage of {app} (the mpv player and, in Xfce, its supervisor) "
"compared with the whole computer. The work the desktop does to compose the "
"video on screen cannot be separated from the desktop itself, so it is not "
"included."
msgstr ""
"Consommation de {app} (le lecteur mpv et, sous Xfce, son superviseur) par "
"rapport à l’ensemble de l’ordinateur. Le travail du bureau pour composer la "
"vidéo à l’écran ne peut pas être isolé du bureau lui-même : il n’est donc "
"pas inclus."

#: src/mintmotion:783
msgid "Uninstall…"
msgstr "Désinstaller…"

#: src/mintmotion:786
#, python-brace-format
msgid ""
"Removes {app} and all its settings from the computer. Your videos are not "
"touched."
msgstr ""
"Supprime {app} et tous ses réglages de l’ordinateur. Vos vidéos ne sont pas "
"touchées."

#: src/mintmotion:789
msgid "Remove video"
msgstr "Retirer la vidéo"

#: src/mintmotion:791
msgid ""
"Stops playing the video and goes back to your static desktop background."
msgstr "Arrête la vidéo et revient à votre fond d’écran fixe."

#: src/mintmotion:793
msgid "Apply"
msgstr "Appliquer"

#: src/mintmotion:795
msgid "Sets the video as background with these options."
msgstr "Met la vidéo en fond d’écran avec ces options."

#: src/mintmotion:805
#, python-brace-format
msgid "{app} · by {author}"
msgstr "{app} · par {author}"

#: src/mintmotion:834
msgid ""
"You are in a Wayland session. The video background only works in the X11 "
"session (the default one in Linux Mint and LMDE)."
msgstr ""
"Vous êtes dans une session Wayland. Le fond vidéo ne fonctionne que dans la "
"session X11 (celle par défaut dans Linux Mint et LMDE)."

#: src/mintmotion:837
#, python-brace-format
msgid "{app} needs the Cinnamon or Xfce desktop."
msgstr "{app} nécessite le bureau Cinnamon ou Xfce."

#: src/mintmotion:839 src/mintmotion:1016 src/mintmotion:1358
#, python-brace-format
msgid "The Xfce part of {app} is not installed (mintmotion-xfce is missing)."
msgstr ""
"La partie Xfce de {app} n’est pas installée (mintmotion-xfce est "
"introuvable)."

#: src/mintmotion:842
msgid "mpv is missing: install it with “sudo apt install mpv”."
msgstr "mpv est absent : installez-le avec « sudo apt install mpv »."

#: src/mintmotion:880
msgid "_Close"
msgstr "_Fermer"

#: src/mintmotion:891
msgid "No video selected"
msgstr "Aucune vidéo sélectionnée"

#: src/mintmotion:899
msgid "The file no longer exists."
msgstr "Le fichier n’existe plus."

#: src/mintmotion:910
msgid "Not recognized as a video."
msgstr "Non reconnu comme une vidéo."

#: src/mintmotion:929
#, python-brace-format
msgid "Ideal for your screen ({w}×{h})."
msgstr "Idéale pour votre écran ({w}×{h})."

#: src/mintmotion:934
#, python-brace-format
msgid "your screen is {w}×{h}"
msgstr "votre écran fait {w}×{h}"

#: src/mintmotion:936
msgid "more than 30 fps costs more without being noticeable in a background"
msgstr ""
"plus de 30 i/s consomme davantage sans que cela se voie sur un fond d’écran"

#: src/mintmotion:938
msgid "H.264 is the format that any graphics card decodes best"
msgstr "H.264 est le format que toutes les cartes graphiques décodent le mieux"

#: src/mintmotion:939
#, python-brace-format
msgid "Can be optimized: {reasons}."
msgstr "Peut être optimisée : {reasons}."

#: src/mintmotion:964
msgid "Choose a video"
msgstr "Choisissez une vidéo"

#: src/mintmotion:966 src/mintmotion:1036 src/mintmotion:1042
#: src/mintmotion:1072
msgid "_Cancel"
msgstr "_Annuler"

#: src/mintmotion:966 src/mintmotion:1042
msgid "_Open"
msgstr "_Ouvrir"

#: src/mintmotion:969
msgid "Videos"
msgstr "Vidéos"

#: src/mintmotion:976
msgid "All files"
msgstr "Tous les fichiers"

#: src/mintmotion:1015
msgid "The video could not be started."
msgstr "La vidéo n’a pas pu être lancée."

#: src/mintmotion:1020
msgid "Cinnamon was not found."
msgstr "Cinnamon est introuvable."

#: src/mintmotion:1021
#, python-brace-format
msgid "{app} works as an extension of the Cinnamon desktop."
msgstr "{app} fonctionne comme une extension du bureau Cinnamon."

#: src/mintmotion:1034
msgid "Your previous desktop background no longer exists"
msgstr "Votre ancien fond d’écran n’existe plus"

#: src/mintmotion:1035
msgid "Choose an image to set as desktop background."
msgstr "Choisissez une image à utiliser comme fond d’écran."

#: src/mintmotion:1037
msgid "_Choose image…"
msgstr "_Choisir une image…"

#: src/mintmotion:1040
msgid "Choose a background image"
msgstr "Choisissez une image de fond"

#: src/mintmotion:1044
msgid "Images"
msgstr "Images"

#: src/mintmotion:1068
#, python-brace-format
msgid "Uninstall {app}?"
msgstr "Désinstaller {app} ?"

#: src/mintmotion:1069
msgid ""
"The program and all its settings will be removed. The desktop will go back "
"to a static background."
msgstr ""
"Le programme et tous ses réglages seront supprimés. Le bureau retrouvera un "
"fond d’écran fixe."

#: src/mintmotion:1071
msgid "Your videos will not be touched."
msgstr "Vos vidéos ne seront pas touchées."

#: src/mintmotion:1073
msgid "_Uninstall"
msgstr "_Désinstaller"

#: src/mintmotion:1078
#, python-brace-format
msgid "{app} is not installed as a package"
msgstr "{app} n’est pas installé en tant que paquet"

#: src/mintmotion:1079
msgid ""
"It seems to be installed from the source code. Uninstall it from that folder "
"with:"
msgstr ""
"Il semble installé depuis le code source. Désinstallez-le depuis ce dossier "
"avec :"

#: src/mintmotion:1083
msgid "pkexec is missing"
msgstr "pkexec est absent"

#: src/mintmotion:1084
msgid ""
"Without pkexec I cannot ask for your password. Uninstall it from a terminal "
"with:"
msgstr ""
"Sans pkexec, je ne peux pas demander votre mot de passe. Désinstallez-le "
"depuis un terminal avec :"

#: src/mintmotion:1094
#, python-brace-format
msgid "What should I do with the videos that {app} created?"
msgstr "Que faire des vidéos créées par {app} ?"

#: src/mintmotion:1095
#, python-brace-format
msgid "“Optimize for my screen” created <b>{n} video</b> ({size}) in"
msgid_plural "“Optimize for my screen” created <b>{n} videos</b> ({size}) in"
msgstr[0] "« Optimiser pour mon écran » a créé <b>{n} vidéo</b> ({size}) dans"
msgstr[1] "« Optimiser pour mon écran » a créé <b>{n} vidéos</b> ({size}) dans"

#: src/mintmotion:1099
msgid "_Keep them"
msgstr "_Les conserver"

#: src/mintmotion:1100
msgid "_Delete them"
msgstr "_Les supprimer"

#: src/mintmotion:1110
msgid "Uninstalling… enter your password if asked."
msgstr "Désinstallation… saisissez votre mot de passe s’il est demandé."

#: src/mintmotion:1129
msgid "You cancelled the password prompt."
msgstr "Vous avez annulé la demande de mot de passe."

#: src/mintmotion:1138
#, python-brace-format
msgid "The optimized videos are still in {folder}."
msgstr "Les vidéos optimisées sont toujours dans {folder}."

#: src/mintmotion:1140
#, python-brace-format
msgid "{app} has been uninstalled"
msgstr "{app} a été désinstallé"

#: src/mintmotion:1141
msgid "Nothing of the program remains on the computer."
msgstr "Il ne reste rien du programme sur l’ordinateur."

#: src/mintmotion:1147
msgid "It was not uninstalled"
msgstr "La désinstallation n’a pas eu lieu"

#: src/mintmotion:1170
msgid "No video: your static desktop background is shown."
msgstr "Aucune vidéo : votre fond d’écran fixe est affiché."

#: src/mintmotion:1172
msgid "Playing on the desktop."
msgstr "Lecture sur le bureau."

#: src/mintmotion:1175
msgid "Paused: the desktop is covered (it barely uses CPU)."
msgstr ""
"En pause : le bureau est recouvert (presque aucune utilisation du "
"processeur)."

#: src/mintmotion:1178
msgid ""
"Sleeping: the desktop has been covered for a while and the player was closed "
"to free its memory. When uncovered, it continues where it was."
msgstr ""
"En veille : le bureau est recouvert depuis un moment et le lecteur a été "
"fermé pour libérer sa mémoire. Quand le bureau redevient visible, la lecture "
"reprend là où elle s’était arrêtée."

#: src/mintmotion:1182
#, python-brace-format
msgid "The player has failed several times (check {log})."
msgstr "Le lecteur a échoué plusieurs fois (consultez {log})."

#: src/mintmotion:1185
#, python-brace-format
msgid "Starting… (if this does not change, check {log})"
msgstr "Démarrage… (si rien ne change, consultez {log})"

#: src/mintmotion:1188
msgid "There are changes not applied yet: press “Apply”."
msgstr ""
"Des modifications ne sont pas encore appliquées : cliquez sur « Appliquer »."

#: src/mintmotion:1190
msgid "Press “Apply” to set the video."
msgstr "Cliquez sur « Appliquer » pour mettre la vidéo."

#: src/mintmotion:1206
msgid "measuring…"
msgstr "mesure…"

#: src/mintmotion:1212
#, no-python-format, python-brace-format
msgid "{total}% of total · {core}% of one core ({n} core)"
msgid_plural "{total}% of total · {core}% of one core ({n} cores)"
msgstr[0] "{total} % du total · {core} % d’un cœur ({n} cœur)"
msgstr[1] "{total} % du total · {core} % d’un cœur ({n} cœurs)"

#: src/mintmotion:1218
#, no-python-format, python-brace-format
msgid "{used} of {total} · {pct}%"
msgstr "{used} sur {total} · {pct} %"

#: src/mintmotion:1241 src/mintmotion:1257
#, no-python-format, python-brace-format
msgid "Optimizing… {pct}%"
msgstr "Optimisation… {pct} %"

#: src/mintmotion:1274
msgid "The video could not be optimized."
msgstr "La vidéo n’a pas pu être optimisée."

#: src/mintmotion:1307
#, python-brace-format
msgid ""
"{app}: video as desktop background in Cinnamon and Xfce. Without arguments "
"it opens the settings window."
msgstr ""
"{app} : vidéo en fond d’écran dans Cinnamon et Xfce. Sans argument, ouvre la "
"fenêtre de réglages."

#: src/mintmotion:1309
msgid "video to use as background (it also enables it)"
msgstr "vidéo à utiliser comme fond (l’active aussi)"

#: src/mintmotion:1310
msgid "screen fit"
msgstr "adaptation à l’écran"

#: src/mintmotion:1311
msgid "scaling quality"
msgstr "qualité de mise à l’échelle"

#: src/mintmotion:1313
msgid "pause when the desktop is covered"
msgstr "pause quand le bureau est recouvert"

#: src/mintmotion:1314
msgid "hardware decoding"
msgstr "décodage matériel"

#: src/mintmotion:1315
msgid "set the video as background"
msgstr "mettre la vidéo en fond d’écran"

#: src/mintmotion:1316
msgid "remove the video background"
msgstr "retirer le fond vidéo"

#: src/mintmotion:1317
msgid "show the status"
msgstr "afficher l’état"

#: src/mintmotion:1324
#, python-brace-format
msgid "could not migrate the previous version: {error}"
msgstr "impossible de migrer la version précédente : {error}"

#: src/mintmotion:1336
#, python-brace-format
msgid "Does not exist: {path}"
msgstr "N’existe pas : {path}"

#: src/mintmotion:1361
msgid "Cinnamon was not found (org.cinnamon schema)."
msgstr "Cinnamon est introuvable (schéma org.cinnamon)."

#: src/mintmotion:1364
msgid "yes"
msgstr "oui"

#: src/mintmotion:1364
msgid "no"
msgstr "non"

#: src/mintmotion:1366
#, python-brace-format
msgid "enabled: {value}"
msgstr "activé : {value}"

#: src/mintmotion:1367
#, python-brace-format
msgid "video: {value}"
msgstr "vidéo : {value}"

#: src/mintmotion:1367
msgid "(none)"
msgstr "(aucune)"

#: src/mintmotion:1368
#, python-brace-format
msgid ""
"fit: {fit} · quality: {quality} · hardware: {hw} · pause when covered: "
"{pause}"
msgstr ""
"adaptation : {fit} · qualité : {quality} · matériel : {hw} · pause si "
"recouvert : {pause}"

#: src/mintmotion:1371
#, python-brace-format
msgid "state: {value}"
msgstr "état : {value}"
