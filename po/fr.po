#: src/mintmotion:96
msgid "Fill the screen (crops the excess)"
msgstr "Remplir l’écran (rogne le surplus)"

#: src/mintmotion:97
msgid "Fit without cropping (black bars)"
msgstr "Ajuster sans rogner (bandes noires)"

#: src/mintmotion:98
msgid "Stretch (may distort)"
msgstr "Étirer (peut déformer)"

#: src/mintmotion:99
msgid "High (recommended)"
msgstr "Haute (recommandée)"

#: src/mintmotion:100
msgid "Maximum (more work for the GPU)"
msgstr "Maximale (plus de travail pour le GPU)"

#: src/mintmotion:101
msgid "Saver (basic scaling)"
msgstr "Économie (mise à l’échelle simple)"

#: src/mintmotion:104
msgid "playing"
msgstr "lecture"

#: src/mintmotion:104
msgid "paused"
msgstr "en pause"

#: src/mintmotion:104
msgid "sleeping"
msgstr "en veille"

#: src/mintmotion:105
msgid "error"
msgstr "erreur"

#: src/mintmotion:105
msgid "stopped"
msgstr "arrêté"

#: src/mintmotion:553
msgid "Video as desktop background"
msgstr "Vidéo en fond d’écran"

#: src/mintmotion:576
msgid "Choose video…"
msgstr "Choisir une vidéo…"

#: src/mintmotion:587
msgid "Optimize for my screen"
msgstr "Optimiser pour mon écran"

#: src/mintmotion:589
msgid "Creates a copy of the video at the exact resolution of your screen, at 30 fps at most and without sound: maximum sharpness and minimum resource usage. The original is not touched."
msgstr "Crée une copie de la vidéo à la résolution exacte de votre écran, à 30 i/s au maximum et sans son : netteté maximale et consommation minimale. L’original n’est pas modifié."

#: src/mintmotion:594
msgid "Cancel"
msgstr "Annuler"

#: src/mintmotion:612
msgid "Screen fit"
msgstr "Adaptation à l’écran"

#: src/mintmotion:613
msgid "Scaling quality"
msgstr "Qualité de mise à l’échelle"

#: src/mintmotion:614
msgid "Pause when the desktop is fully covered"
msgstr "Mettre en pause quand le bureau est entièrement recouvert"

#: src/mintmotion:615
msgid "Hardware decoding"
msgstr "Décodage matériel"

#: src/mintmotion:629
msgid "Resource usage of MintMotion (the mpv player) compared with the whole computer. The work Cinnamon does to show the video happens inside Cinnamon and cannot be separated, so it is not included."
msgstr "Consommation de MintMotion (le lecteur mpv) par rapport à l’ensemble de l’ordinateur. Le travail de Cinnamon pour afficher la vidéo se fait dans Cinnamon et ne peut pas être isolé : il n’est donc pas inclus."

#: src/mintmotion:658
msgid "Uninstall…"
msgstr "Désinstaller…"

#: src/mintmotion:661
#, python-brace-format
msgid "Removes {app} and all its settings from the computer. Your videos are not touched."
msgstr "Supprime {app} et tous ses réglages de l’ordinateur. Vos vidéos ne sont pas touchées."

#: src/mintmotion:664
msgid "Remove video"
msgstr "Retirer la vidéo"

#: src/mintmotion:666
msgid "Stops playing the video and goes back to your static desktop background."
msgstr "Arrête la vidéo et revient à votre fond d’écran fixe."

#: src/mintmotion:668
msgid "Apply"
msgstr "Appliquer"

#: src/mintmotion:670
msgid "Sets the video as background with these options."
msgstr "Met la vidéo en fond d’écran avec ces options."

#: src/mintmotion:680
#, python-brace-format
msgid "{app} · by {author}"
msgstr "{app} · par {author}"

#: src/mintmotion:709
msgid "You are in a Wayland session. The video background only works in the X11 session of Cinnamon (the default one in Linux Mint and LMDE)."
msgstr "Vous êtes dans une session Wayland. Le fond vidéo ne fonctionne que dans la session X11 de Cinnamon (celle par défaut dans Linux Mint et LMDE)."

#: src/mintmotion:713
#, python-brace-format
msgid "{app} needs the Cinnamon desktop."
msgstr "{app} nécessite le bureau Cinnamon."

#: src/mintmotion:715
msgid "mpv is missing: install it with “sudo apt install mpv”."
msgstr "mpv est absent : installez-le avec « sudo apt install mpv »."

#: src/mintmotion:753
msgid "_Close"
msgstr "_Fermer"

#: src/mintmotion:764
msgid "No video selected"
msgstr "Aucune vidéo sélectionnée"

#: src/mintmotion:772
msgid "The file no longer exists."
msgstr "Le fichier n’existe plus."

#: src/mintmotion:783
msgid "Not recognized as a video."
msgstr "Non reconnu comme une vidéo."

#: src/mintmotion:802
#, python-brace-format
msgid "Ideal for your screen ({w}×{h})."
msgstr "Idéale pour votre écran ({w}×{h})."

#: src/mintmotion:807
#, python-brace-format
msgid "your screen is {w}×{h}"
msgstr "votre écran fait {w}×{h}"

#: src/mintmotion:809
msgid "more than 30 fps costs more without being noticeable in a background"
msgstr "plus de 30 i/s consomme davantage sans que cela se voie sur un fond d’écran"

#: src/mintmotion:811
msgid "H.264 is the format that any graphics card decodes best"
msgstr "H.264 est le format que toutes les cartes graphiques décodent le mieux"

#: src/mintmotion:812
#, python-brace-format
msgid "Can be optimized: {reasons}."
msgstr "Peut être optimisée : {reasons}."

#: src/mintmotion:837
msgid "Choose a video"
msgstr "Choisissez une vidéo"

#: src/mintmotion:839 src/mintmotion:902 src/mintmotion:908 src/mintmotion:938
msgid "_Cancel"
msgstr "_Annuler"

#: src/mintmotion:839 src/mintmotion:908
msgid "_Open"
msgstr "_Ouvrir"

#: src/mintmotion:842
msgid "Videos"
msgstr "Vidéos"

#: src/mintmotion:849
msgid "All files"
msgstr "Tous les fichiers"

#: src/mintmotion:887
msgid "Cinnamon was not found."
msgstr "Cinnamon est introuvable."

#: src/mintmotion:888
#, python-brace-format
msgid "{app} works as an extension of the Cinnamon desktop."
msgstr "{app} fonctionne comme une extension du bureau Cinnamon."

#: src/mintmotion:900
msgid "Your previous desktop background no longer exists"
msgstr "Votre ancien fond d’écran n’existe plus"

#: src/mintmotion:901
msgid "Choose an image to set as desktop background."
msgstr "Choisissez une image à utiliser comme fond d’écran."

#: src/mintmotion:903
msgid "_Choose image…"
msgstr "_Choisir une image…"

#: src/mintmotion:906
msgid "Choose a background image"
msgstr "Choisissez une image de fond"

#: src/mintmotion:910
msgid "Images"
msgstr "Images"

#: src/mintmotion:934
#, python-brace-format
msgid "Uninstall {app}?"
msgstr "Désinstaller {app} ?"

#: src/mintmotion:935
msgid "The program, its Cinnamon extension and all its settings will be removed. The desktop will go back to a static background."
msgstr "Le programme, son extension Cinnamon et tous ses réglages seront supprimés. Le bureau retrouvera un fond d’écran fixe."

#: src/mintmotion:937
msgid "Your videos will not be touched."
msgstr "Vos vidéos ne seront pas touchées."

#: src/mintmotion:939
msgid "_Uninstall"
msgstr "_Désinstaller"

#: src/mintmotion:944
#, python-brace-format
msgid "{app} is not installed as a package"
msgstr "{app} n’est pas installé en tant que paquet"

#: src/mintmotion:945
msgid "It seems to be installed from the source code. Uninstall it from that folder with:"
msgstr "Il semble installé depuis le code source. Désinstallez-le depuis ce dossier avec :"

#: src/mintmotion:949
msgid "pkexec is missing"
msgstr "pkexec est absent"

#: src/mintmotion:950
msgid "Without pkexec I cannot ask for your password. Uninstall it from a terminal with:"
msgstr "Sans pkexec, je ne peux pas demander votre mot de passe. Désinstallez-le depuis un terminal avec :"

#: src/mintmotion:960
#, python-brace-format
msgid "What should I do with the videos that {app} created?"
msgstr "Que faire des vidéos créées par {app} ?"

#: src/mintmotion:961
#, python-brace-format
msgid "“Optimize for my screen” created <b>{n} video</b> ({size}) in"
msgid_plural "“Optimize for my screen” created <b>{n} videos</b> ({size}) in"
msgstr[0] "« Optimiser pour mon écran » a créé <b>{n} vidéo</b> ({size}) dans"
msgstr[1] "« Optimiser pour mon écran » a créé <b>{n} vidéos</b> ({size}) dans"

#: src/mintmotion:965
msgid "_Keep them"
msgstr "_Les conserver"

#: src/mintmotion:966
msgid "_Delete them"
msgstr "_Les supprimer"

#: src/mintmotion:976
msgid "Uninstalling… enter your password if asked."
msgstr "Désinstallation… saisissez votre mot de passe s’il est demandé."

#: src/mintmotion:995
msgid "You cancelled the password prompt."
msgstr "Vous avez annulé la demande de mot de passe."

#: src/mintmotion:1004
#, python-brace-format
msgid "The optimized videos are still in {folder}."
msgstr "Les vidéos optimisées sont toujours dans {folder}."

#: src/mintmotion:1006
#, python-brace-format
msgid "{app} has been uninstalled"
msgstr "{app} a été désinstallé"

#: src/mintmotion:1007
msgid "Nothing of the program remains on the computer."
msgstr "Il ne reste rien du programme sur l’ordinateur."

#: src/mintmotion:1013
msgid "It was not uninstalled"
msgstr "La désinstallation n’a pas eu lieu"

#: src/mintmotion:1024
msgid "No video: your static desktop background is shown."
msgstr "Aucune vidéo : votre fond d’écran fixe est affiché."

#: src/mintmotion:1026
msgid "Playing on the desktop."
msgstr "Lecture sur le bureau."

#: src/mintmotion:1029
msgid "Paused: the desktop is covered (it barely uses CPU)."
msgstr "En pause : le bureau est recouvert (presque aucune utilisation du processeur)."

#: src/mintmotion:1032
msgid "Sleeping: the desktop has been covered for a while and the player was closed to free its memory. When uncovered, it continues where it was."
msgstr "En veille : le bureau est recouvert depuis un moment et le lecteur a été fermé pour libérer sa mémoire. Quand le bureau redevient visible, la lecture reprend là où elle s’était arrêtée."

#: src/mintmotion:1036
msgid "The player has failed several times (check ~/.xsession-errors)."
msgstr "Le lecteur a échoué plusieurs fois (consultez ~/.xsession-errors)."

#: src/mintmotion:1039
msgid "Starting… (if this does not change, check ~/.xsession-errors)"
msgstr "Démarrage… (si rien ne change, consultez ~/.xsession-errors)"

#: src/mintmotion:1042
msgid "There are changes not applied yet: press “Apply”."
msgstr "Des modifications ne sont pas encore appliquées : cliquez sur « Appliquer »."

#: src/mintmotion:1044
msgid "Press “Apply” to set the video."
msgstr "Cliquez sur « Appliquer » pour mettre la vidéo."

#: src/mintmotion:1060
msgid "measuring…"
msgstr "mesure…"

#: src/mintmotion:1066
#, no-python-format, python-brace-format
msgid "{total}% of total · {core}% of one core ({n} core)"
msgid_plural "{total}% of total · {core}% of one core ({n} cores)"
msgstr[0] "{total} % du total · {core} % d’un cœur ({n} cœur)"
msgstr[1] "{total} % du total · {core} % d’un cœur ({n} cœurs)"

#: src/mintmotion:1072
#, no-python-format, python-brace-format
msgid "{used} of {total} · {pct}%"
msgstr "{used} sur {total} · {pct} %"

#: src/mintmotion:1095 src/mintmotion:1111
#, no-python-format, python-brace-format
msgid "Optimizing… {pct}%"
msgstr "Optimisation… {pct} %"

#: src/mintmotion:1128
msgid "The video could not be optimized."
msgstr "La vidéo n’a pas pu être optimisée."

#: src/mintmotion:1161
#, python-brace-format
msgid "{app}: video as desktop background in Cinnamon. Without arguments it opens the settings window."
msgstr "{app} : vidéo en fond d’écran dans Cinnamon. Sans argument, ouvre la fenêtre de réglages."

#: src/mintmotion:1163
msgid "video to use as background (it also enables it)"
msgstr "vidéo à utiliser comme fond (l’active aussi)"

#: src/mintmotion:1164
msgid "screen fit"
msgstr "adaptation à l’écran"

#: src/mintmotion:1165
msgid "scaling quality"
msgstr "qualité de mise à l’échelle"

#: src/mintmotion:1167
msgid "pause when the desktop is covered"
msgstr "pause quand le bureau est recouvert"

#: src/mintmotion:1168
msgid "hardware decoding"
msgstr "décodage matériel"

#: src/mintmotion:1169
msgid "set the video as background"
msgstr "mettre la vidéo en fond d’écran"

#: src/mintmotion:1170
msgid "remove the video background"
msgstr "retirer le fond vidéo"

#: src/mintmotion:1171
msgid "show the status"
msgstr "afficher l’état"

#: src/mintmotion:1178
#, python-brace-format
msgid "could not migrate the previous version: {error}"
msgstr "impossible de migrer la version précédente : {error}"

#: src/mintmotion:1190
#, python-brace-format
msgid "Does not exist: {path}"
msgstr "N’existe pas : {path}"

#: src/mintmotion:1211
msgid "Cinnamon was not found (org.cinnamon schema)."
msgstr "Cinnamon est introuvable (schéma org.cinnamon)."

#: src/mintmotion:1214
msgid "yes"
msgstr "oui"

#: src/mintmotion:1214
msgid "no"
msgstr "non"

#: src/mintmotion:1216
#, python-brace-format
msgid "enabled: {value}"
msgstr "activé : {value}"

#: src/mintmotion:1217
#, python-brace-format
msgid "video: {value}"
msgstr "vidéo : {value}"

#: src/mintmotion:1217
msgid "(none)"
msgstr "(aucune)"

#: src/mintmotion:1218
#, python-brace-format
msgid "fit: {fit} · quality: {quality} · hardware: {hw} · pause when covered: {pause}"
msgstr "adaptation : {fit} · qualité : {quality} · matériel : {hw} · pause si recouvert : {pause}"

#: src/mintmotion:1221
#, python-brace-format
msgid "state: {value}"
msgstr "état : {value}"
