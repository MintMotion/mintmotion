def _setup_i18n():
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    here = os.path.dirname(os.path.realpath(__file__))
    dirs = [os.path.join(here, "..", "build", "locale"),          # ejecutado desde el código fuente
            os.path.join(here, "..", "share", "locale"),           # instalado con PREFIX=...
            "/usr/share/locale", "/usr/local/share/locale"]
    for d in dirs:
        t = gettext.translation(DOMAIN, d, fallback=True)
        if type(t) is not gettext.NullTranslations:
            return t
    return gettext.NullTranslations()


