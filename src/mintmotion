def mpv_sockets():
    """Sockets IPC de los mpv en marcha: uno en Cinnamon; en Xfce, uno por monitor."""
    try:
        with open(SOCKET_POINTER, encoding="utf-8") as f:
            return [line for line in f.read().splitlines() if line.strip()]
    except OSError:
        return []


def mpv_query_all(prop, timeout=0.5):
    """Valor de una propiedad en cada mpv que responda."""
    values = (_mpv_query(path, prop, timeout) for path in mpv_sockets())
    return [v for v in values if v is not None]


def mpv_query(prop, timeout=0.5):
    """Lee una propiedad del mpv del fondo. None si no está en marcha."""
    for path in mpv_sockets():
        v = _mpv_query(path, prop, timeout)
        if v is not None:
            return v
    return None


def _mpv_query(path, prop, timeout):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(path)
            s.sendall(json.dumps({"command": ["get_property", prop]}).encode() + b"\n")
            data = b""
            while not data.endswith(b"\n"):
                chunk = s.recv(4096)
                if not chunk:
                    break
                data += chunk
        for line in data.decode(errors="replace").splitlines():
            msg = json.loads(line)
            if "error" in msg:
                return msg.get("data") if msg["error"] == "success" else None
    except (OSError, ValueError):
        return None
    return None


def playback_status():
    paused = mpv_query_all("pause")
    if paused:
        return "pausado" if all(paused) else "reproduciendo"
    # mpv no está abierto: la extensión dice por qué (p. ej. «dormido»: lo ha
    # cerrado porque el escritorio lleva rato tapado)
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            state = f.read().strip()
        if state in ("dormido", "error"):
            return state
    except OSError:
        pass
    return "detenido"


def probe_video(path):
    """Resolución, fps, códec y duración con ffprobe. None si no es un vídeo válido."""
    if not shutil.which("ffprobe"):
        return {}
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height,codec_name,avg_frame_rate,r_frame_rate:format=duration",
             "-of", "json", path],
            capture_output=True, text=True, timeout=20).stdout
        data = json.loads(out)
        st = data["streams"][0]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError):
        return None

    def rate(s):
        try:
            n, d = s.split("/")
            return float(n) / float(d) if float(d) else 0.0
        except (ValueError, AttributeError):
            return 0.0

    fps = rate(st.get("avg_frame_rate")) or rate(st.get("r_frame_rate"))
    try:
        duration = float(data.get("format", {}).get("duration", 0))
    except ValueError:
        duration = 0.0
    return {"width": int(st.get("width", 0)), "height": int(st.get("height", 0)),
            "codec": st.get("codec_name", "?"), "fps": fps, "duration": duration}


def screen_size():
    """Resolución física del monitor más grande."""
    import gi
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk
    disp = Gdk.Display.get_default()
    best = (0, 0)
    if disp:
        for i in range(disp.get_n_monitors()):
            mon = disp.get_monitor(i)
            g = mon.get_geometry()
            sf = mon.get_scale_factor()
            w, h = g.width * sf, g.height * sf
            if w * h > best[0] * best[1]:
                best = (w, h)
    return best


def optimized_command(src, dst, width, height, fps, fit="rellenar"):
    """ffmpeg: H.264 a la resolución exacta de la pantalla, ≤30 fps y sin sonido.
    Así mpv no tiene que escalar nada y la GPU decodifica con el mínimo trabajo.
    Respeta el modo de ajuste: rellenar recorta, ajustar añade bandas negras,
    estirar deforma."""
    target_fps = 30 if (not fps or fps > 30.5) else round(fps, 3)
    if fit == "ajustar":
        geo = (f"scale={width}:{height}:force_original_aspect_ratio=decrease:flags=lanczos,"
               f"pad={width}:{height}:(ow-iw)/2:(oh-ih)/2:color=black")
    elif fit == "estirar":
        geo = f"scale={width}:{height}:flags=lanczos,setsar=1"
    else:
        geo = (f"scale={width}:{height}:force_original_aspect_ratio=increase:flags=lanczos,"
               f"crop={width}:{height}")
    vf = f"{geo},fps={target_fps},format=yuv420p"
    return ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-nostdin",
            "-i", src, "-an", "-sn", "-dn", "-vf", vf,
            "-c:v", "libx264", "-preset", "slow", "-crf", "18",
            # 2 fotogramas de referencia: el decodificador guarda menos
            # fotogramas en memoria (se nota en equipos sin decodificación por
            # hardware); con el CRF fijo la calidad no cambia, el archivo
            # crece un poco.
            "-refs", "2",
            "-profile:v", "high", "-level", "5.1" if width * height > 2560 * 1440 else "4.2",
            "-movflags", "+faststart", "-progress", "pipe:1", "-nostats", dst]


