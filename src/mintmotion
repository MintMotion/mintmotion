def migrate_legacy():
    """Pasa la configuración de «Fondo de vídeo» 1.0 a MintMotion y retira la
    extensión antigua. No hace nada si no hay restos de la versión anterior."""
    moved = False
    if os.path.isdir(LEGACY_DATA_DIR):
        os.makedirs(DATA_DIR, exist_ok=True)
        for name in os.listdir(LEGACY_DATA_DIR):
            src = os.path.join(LEGACY_DATA_DIR, name)
            dst = os.path.join(DATA_DIR, name)
            if os.path.isfile(src) and not os.path.exists(dst):
                shutil.move(src, dst)
        try:
            os.rmdir(LEGACY_DATA_DIR)
        except OSError:
            pass
        moved = True
    legacy_cfg = os.path.join(LEGACY_CONFIG_DIR, "config.json")
    if os.path.isfile(legacy_cfg):
        if not os.path.isfile(CONFIG_FILE):
            cfg = _read_config(legacy_cfg)
            v = cfg.get("video") or ""
            if v.startswith(LEGACY_DATA_DIR + os.sep):
                cfg["video"] = os.path.join(DATA_DIR, os.path.basename(v))
            save_config(cfg)
        shutil.rmtree(LEGACY_CONFIG_DIR, ignore_errors=True)
        moved = True
    shutil.rmtree(LEGACY_CACHE_DIR, ignore_errors=True)
    try:
        os.unlink(LEGACY_POINTER)
    except OSError:
        pass
    s = _settings("org.cinnamon")
    if s:
        current = s.get_strv("enabled-extensions")
        if LEGACY_UUID in current:
            new = [u for u in current if u != LEGACY_UUID]
            if extension_installed() and UUID not in new:
                new.append(UUID)  # estaba activado: sigue activado con el programa nuevo
            s.set_strv("enabled-extensions", new)
            _sync_settings()
            moved = True
    return moved


def static_background_ok():
    """¿Tiene Cinnamon un fondo estático válido (imagen existente o color liso)?
    En Xfce siempre lo hay: el supervisor devuelve a xfdesktop el fondo que
    tenía y, si su imagen ya no existe, xfdesktop pinta su color de fondo."""
    if desktop_backend() == "xfce":
        return True
    s = _settings("org.cinnamon.desktop.background")
    if not s:
        return True  # sin esquema no podemos comprobarlo; no molestamos
    if s.get_string("picture-options") == "none":
        return True  # fondo de color liso
    uri = s.get_string("picture-uri")
    if not uri:
        return False
    from gi.repository import Gio
    path = Gio.File.new_for_uri(uri).get_path()
    return bool(path) and os.path.isfile(path)


