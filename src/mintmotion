def _proc_stat(pid):
    """(ppid, ticks de CPU usados) de /proc/<pid>/stat, o None."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            data = f.read()
        fields = data[data.rindex(")") + 2:].split()
        return int(fields[1]), int(fields[11]) + int(fields[12])
    except (OSError, ValueError, IndexError):
        return None


def _proc_ram_kb(pid):
    """Memoria real del proceso (PSS: reparte lo compartido); si no, RSS."""
    for path, key in ((f"/proc/{pid}/smaps_rollup", "Pss:"), (f"/proc/{pid}/status", "VmRSS:")):
        try:
            with open(path) as f:
                for line in f:
                    if line.startswith(key):
                        return int(line.split()[1])
        except (OSError, ValueError, IndexError):
            pass
    return 0


def _proc_comm(pid):
    try:
        with open(f"/proc/{pid}/comm") as f:
            return f.read().strip()
    except OSError:
        return ""


def total_ram_kb():
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return 0


class UsageMeter:
    """CPU y RAM de MintMotion. En Cinnamon el único proceso que queda en
    marcha es mpv (la ventana la crea un ayudante que termina al momento). En
    Xfce hay un mpv por monitor y, además, el supervisor."""

    def __init__(self):
        self.mpv_pids = []
        self.sockets = None
        self.pids = []
        self.last = None   # (instante, ticks)
        self.hz = os.sysconf("SC_CLK_TCK")
        self.ncpu = os.cpu_count() or 1
        self.ram_total = total_ram_kb()

    def _pids(self):
        sockets = mpv_sockets()
        if sockets != self.sockets or not self.mpv_pids or \
                any(_proc_comm(p) != "mpv" for p in self.mpv_pids):
            self.sockets = sockets
            self.mpv_pids = sorted(p for p in mpv_query_all("pid") if isinstance(p, int))
        pids = [p for p in self.mpv_pids if _proc_stat(p)]
        if desktop_backend() == "xfce":
            daemon = xfce_daemon_pid()   # sigue en marcha aunque mpv esté en reposo
            if daemon:
                pids.append(daemon)
        if pids != self.pids:
            self.pids = pids
            self.last = None   # han cambiado los procesos: la CPU se mide de nuevo
        return pids

    def sample(self):
        """None si no hay vídeo; si no, dict con cpu_total, cpu_core, ram_kb, ram_pct.
        cpu_* es None en la primera muestra (hace falta un intervalo)."""
        import time
        pids = self._pids()
        if not pids:
            return None
        ticks = sum((_proc_stat(p) or (0, 0))[1] for p in pids)
        ram = sum(_proc_ram_kb(p) for p in pids)
        now = time.monotonic()
        cpu_core = cpu_total = None
        if self.last and now > self.last[0]:
            used = max(ticks - self.last[1], 0) / self.hz      # segundos de CPU
            cpu_core = 100.0 * used / (now - self.last[0])     # % de un núcleo
            cpu_total = cpu_core / self.ncpu                   # % de toda la CPU
        self.last = (now, ticks)
        return {"cpu_core": cpu_core, "cpu_total": cpu_total, "ram_kb": ram,
                "ram_pct": 100.0 * ram / self.ram_total if self.ram_total else 0.0}


def fmt_num(x, dec=1):
    """Número con el separador decimal del idioma del sistema (2,0 / 2.0)."""
    try:
        return locale.format_string(f"%.{dec}f", x)
    except (ValueError, TypeError):
        return f"{x:.{dec}f}"


def human_size(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            if unit in ("B", "KB") or (unit == "MB" and n >= 100):
                return f"{n:.0f} {unit}"
            return f"{fmt_num(n)} {unit}"
        n /= 1024


# ---------------------------------------------------------------------------
