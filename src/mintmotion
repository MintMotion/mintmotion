def run_gui():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gtk, Gdk, GLib, GdkPixbuf, Pango

    # Las barras de consumo deben ser proporcionales al valor. Algunos temas
    # (Mint-Y, Adwaita) dan al tramo relleno un ancho mínimo de 32 px, y así un
    # 0,2 % se veía casi como un 20 %. Se anula solo en estas barras.
    css = Gtk.CssProvider()
    css.load_from_data(b"levelbar.mintmotion-meter block { min-width: 0; min-height: 0; }")
    screen = Gdk.Screen.get_default()
    if screen:
        Gtk.StyleContext.add_provider_for_screen(screen, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    class Window(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title=APP_NAME)
            self.app = app
            self.set_default_size(560, -1)
            self.set_icon_name("mintmotion")
            self.applied = load_config()        # lo que está aplicado
            self.cfg = dict(self.applied)       # lo que se está editando
            self.enabled = extension_enabled()
            self.info = None
            self.ff_proc = None
            self.busy = False
            self.last_spawn = 0      # última vez que se lanzó el supervisor de Xfce
            self._loading = True

            header = Gtk.HeaderBar(show_close_button=True, title=APP_NAME,
                                   subtitle=_("Video as desktop background"))
            self.set_titlebar(header)

            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                           margin_start=18, margin_end=18, margin_top=18, margin_bottom=8)
            self.add(root)

            self.infobar = Gtk.InfoBar(message_type=Gtk.MessageType.WARNING, no_show_all=True)
            self.infobar_label = Gtk.Label(wrap=True, xalign=0)
            self.infobar.get_content_area().add(self.infobar_label)
            self.infobar_label.show()
            root.pack_start(self.infobar, False, False, 0)

            # Vista previa
            frame = Gtk.Frame(shadow_type=Gtk.ShadowType.IN)
            self.preview = Gtk.Image(height_request=270)
            frame.add(self.preview)
            root.pack_start(frame, False, False, 0)

            # Archivo
            row = Gtk.Box(spacing=8)
            self.file_label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
            self.file_label.get_style_context().add_class("dim-label")
            self.choose_button = Gtk.Button(label=_("Choose video…"))
            self.choose_button.connect("clicked", self.on_choose)
            row.pack_start(self.file_label, True, True, 0)
            row.pack_end(self.choose_button, False, False, 0)
            root.pack_start(row, False, False, 0)

            self.details = Gtk.Label(xalign=0, wrap=True, use_markup=True)
            root.pack_start(self.details, False, False, 0)

            # Optimizar
            self.opt_box = Gtk.Box(spacing=8, no_show_all=True)
            self.opt_button = Gtk.Button(label=_("Optimize for my screen"))
            self.opt_button.set_tooltip_text(
                _("Creates a copy of the video at the exact resolution of your screen, at 30 fps at "
                  "most and without sound: maximum sharpness and minimum resource usage. The original "
                  "is not touched."))
            self.opt_button.connect("clicked", self.on_optimize)
            self.opt_progress = Gtk.ProgressBar(show_text=True, valign=Gtk.Align.CENTER, no_show_all=True)
            self.opt_cancel = Gtk.Button(label=_("Cancel"), no_show_all=True)
            self.opt_cancel.connect("clicked", self.on_optimize_cancel)
            self.opt_box.pack_start(self.opt_button, False, False, 0)
            self.opt_box.pack_start(self.opt_progress, True, True, 0)
            self.opt_box.pack_end(self.opt_cancel, False, False, 0)
            self.opt_button.show()
            root.pack_start(self.opt_box, False, False, 0)

            # Opciones
            grid = Gtk.Grid(column_spacing=12, row_spacing=10, margin_top=6)
            root.pack_start(grid, False, False, 0)

            self.fit_combo = self._combo(FITS, self.cfg["fit"])
            self.quality_combo = self._combo(QUALITIES, self.cfg["quality"])
            self.pause_switch = Gtk.Switch(active=self.cfg["pause_when_covered"], halign=Gtk.Align.END)
            self.hw_switch = Gtk.Switch(active=self.cfg["hwdec"], halign=Gtk.Align.END)

            rows = [
                (_("Screen fit"), self.fit_combo),
                (_("Scaling quality"), self.quality_combo),
                (_("Pause when the desktop is fully covered"), self.pause_switch),
                (_("Hardware decoding"), self.hw_switch),
            ]
            for i, (text, widget) in enumerate(rows):
                lab = Gtk.Label(label=text, xalign=0, wrap=True, hexpand=True)
                grid.attach(lab, 0, i, 1, 1)
                grid.attach(widget, 1, i, 1, 1)

            self.status = Gtk.Label(xalign=0, use_markup=True, wrap=True, margin_top=6)
            root.pack_start(self.status, False, False, 0)

            # Consumo real del programa frente al total del equipo
            self.meter = UsageMeter()
            self.usage = Gtk.Grid(column_spacing=10, row_spacing=4, no_show_all=True)
            self.usage.set_tooltip_text(
                _("Resource usage of {app} (the mpv player and, in Xfce, its supervisor) compared "
                  "with the whole computer. The work the desktop does to compose the video on "
                  "screen cannot be separated from the desktop itself, so it is not "
                  "included.").format(app=APP_NAME))
            self.cpu_bar = Gtk.LevelBar(min_value=0, max_value=100, hexpand=True,
                                        valign=Gtk.Align.CENTER)
            self.ram_bar = Gtk.LevelBar(min_value=0, max_value=100, hexpand=True,
                                        valign=Gtk.Align.CENTER)
            for bar in (self.cpu_bar, self.ram_bar):
                for name in ("low", "high", "full"):
                    bar.remove_offset_value(name)  # color neutro: no es un aviso
                bar.set_size_request(-1, 8)
                bar.get_style_context().add_class("mintmotion-meter")
            self.cpu_text = Gtk.Label(xalign=0)
            self.ram_text = Gtk.Label(xalign=0)
            for i, (name, bar, text) in enumerate((("CPU", self.cpu_bar, self.cpu_text),
                                                   ("RAM", self.ram_bar, self.ram_text))):
                lab = Gtk.Label(label=name, xalign=0)
                lab.get_style_context().add_class("dim-label")
                text.get_style_context().add_class("dim-label")
                self.usage.attach(lab, 0, i, 1, 1)
                self.usage.attach(bar, 1, i, 1, 1)
                self.usage.attach(text, 2, i, 1, 1)
                lab.show()
                bar.show()
                text.show()
            root.pack_start(self.usage, False, False, 0)

            # Botones
            buttons = Gtk.Box(spacing=8, margin_top=8)
            self.uninstall_button = Gtk.Button(label=_("Uninstall…"))
            self.uninstall_button.get_style_context().add_class("destructive-action")
            self.uninstall_button.set_tooltip_text(
                _("Removes {app} and all its settings from the computer. Your videos are not "
                  "touched.").format(app=APP_NAME))
            self.uninstall_button.connect("clicked", self.on_uninstall)
            self.remove_button = Gtk.Button(label=_("Remove video"))
            self.remove_button.set_tooltip_text(
                _("Stops playing the video and goes back to your static desktop background."))
            self.remove_button.connect("clicked", self.on_remove_video)
            self.apply_button = Gtk.Button(label=_("Apply"))
            self.apply_button.get_style_context().add_class("suggested-action")
            self.apply_button.set_tooltip_text(_("Sets the video as background with these options."))
            self.apply_button.connect("clicked", self.on_apply)
            buttons.pack_start(self.uninstall_button, False, False, 0)
            buttons.pack_end(self.apply_button, False, False, 0)
            buttons.pack_end(self.remove_button, False, False, 0)
            root.pack_start(buttons, False, False, 0)

            # Firma
            credit = Gtk.Label(halign=Gtk.Align.END, use_markup=True)
            credit.set_markup("<small>" + GLib.markup_escape_text(
                _("{app} · by {author}").format(app=APP_NAME, author=AUTHOR)) + "</small>")
            credit.set_tooltip_text(f"{AUTHOR_FULL} «{AUTHOR}» <{AUTHOR_EMAIL}>")
            credit.get_style_context().add_class("dim-label")
            root.pack_start(credit, False, False, 0)

            self.fit_combo.connect("changed", self.on_option_changed)
            self.quality_combo.connect("changed", self.on_option_changed)
            self.pause_switch.connect("notify::active", self.on_option_changed)
            self.hw_switch.connect("notify::active", self.on_option_changed)
            self.connect("destroy", self.on_destroy)

            self.check_environment()
            self.load_video(self.cfg["video"])
            self._loading = False
            self.refresh_status()
            self.status_timer = GLib.timeout_add_seconds(2, self.refresh_status)

        # ----- utilidades -----

        def _combo(self, items, active):
            c = Gtk.ComboBoxText()
            for key, text in items:
                c.append(key, _(text))
            c.set_active_id(active if active in dict(items) else items[0][0])
            return c

        def check_environment(self):
            problems = []
            if os.environ.get("XDG_SESSION_TYPE", "x11") == "wayland":
                problems.append(_("You are in a Wayland session. The video background only works "
                                  "in the X11 session (the default one in Linux Mint and LMDE)."))
            if desktop_backend() is None:
                problems.append(_("{app} needs the Cinnamon or Xfce desktop.").format(app=APP_NAME))
            elif desktop_backend() == "xfce" and not xfce_daemon_path():
                problems.append(_("The Xfce part of {app} is not installed "
                                  "(mintmotion-xfce is missing).").format(app=APP_NAME))
            if not shutil.which("mpv"):
                problems.append(_("mpv is missing: install it with “sudo apt install mpv”."))
            if problems:
                self.infobar_label.set_text("\n".join(problems))
                self.infobar.show()

        def pending(self):
            """¿Hay cambios en la ventana que todavía no se han aplicado?"""
            return self.cfg != self.applied

        def video_ok(self):
            v = self.cfg.get("video")
            return bool(v) and os.path.isfile(v) and self.info is not None

        def update_buttons(self):
            idle = not self.busy and self.ff_proc is None
            self.apply_button.set_sensitive(idle and self.video_ok() and
                                            (self.pending() or not self.enabled))
            self.remove_button.set_sensitive(idle and self.enabled)
            self.uninstall_button.set_sensitive(idle)
            self.choose_button.set_sensitive(idle)

        def ask(self, title, text, buttons, kind=Gtk.MessageType.QUESTION):
            """Diálogo con botones propios. buttons = [(texto, respuesta, clase_css), …]"""
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=kind,
                                  buttons=Gtk.ButtonsType.NONE, text=title)
            if text:
                d.format_secondary_markup(text)
            for label, resp, css in buttons:
                b = d.add_button(label, resp)
                if css:
                    b.get_style_context().add_class(css)
            r = d.run()
            d.destroy()
            return r

        def message(self, title, text="", kind=Gtk.MessageType.INFO):
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=kind,
                                  buttons=Gtk.ButtonsType.NONE, text=title)
            d.add_button(_("_Close"), Gtk.ResponseType.CLOSE)
            if text:
                d.format_secondary_markup(text)
            d.run()
            d.destroy()

        # ----- vídeo -----

        def load_video(self, path):
            self.info = None
            if not path:
                self.file_label.set_text(_("No video selected"))
                self.details.set_markup("")
                self.preview.set_from_icon_name("video-x-generic", Gtk.IconSize.DIALOG)
                self.opt_box.hide()
                return
            self.file_label.set_text(path.replace(os.path.expanduser("~"), "~", 1))
            self.file_label.set_tooltip_text(path)
            if not os.path.isfile(path):
                self.details.set_markup("<span foreground='#c01c28'>" + _("The file no longer exists.") + "</span>")
                self.preview.set_from_icon_name("dialog-error", Gtk.IconSize.DIALOG)
                self.opt_box.hide()
                return
            self.info = probe_video(path)
            self.show_details()
            self.make_thumbnail(path)

        def show_details(self):
            info = self.info
            if info is None:
                self.details.set_markup("<span foreground='#c01c28'>" + _("Not recognized as a video.") + "</span>")
                self.opt_box.hide()
                return
            if not info:
                self.details.set_markup("")
                self.opt_box.hide()
                return
            sw, sh = screen_size()
            parts = [f"{info['width']}×{info['height']}",
                     f"{info['fps']:.0f} fps" if info["fps"] else None,
                     info["codec"].upper()]
            if info["duration"]:
                m, s = divmod(int(round(info["duration"])), 60)
                parts.append(f"{m}:{s:02d} min")
            text = " · ".join(p for p in parts if p)
            exact = (info["width"], info["height"]) == (sw, sh)
            heavy = (info["fps"] > 30.5) or info["codec"] not in ("h264",)
            if sw and exact and not heavy:
                text += ("\n<span foreground='#26a269'>" +
                         _("Ideal for your screen ({w}×{h}).").format(w=sw, h=sh) + "</span>")
                self.opt_box.hide()
            elif sw:
                why = []
                if not exact:
                    why.append(_("your screen is {w}×{h}").format(w=sw, h=sh))
                if info["fps"] > 30.5:
                    why.append(_("more than 30 fps costs more without being noticeable in a background"))
                if info["codec"] != "h264":
                    why.append(_("H.264 is the format that any graphics card decodes best"))
                text += "\n<small>" + _("Can be optimized: {reasons}.").format(reasons="; ".join(why)) + "</small>"
                self.opt_box.set_visible(bool(shutil.which("ffmpeg")))
            self.details.set_markup(text)

        def make_thumbnail(self, path):
            if not shutil.which("ffmpeg"):
                self.preview.set_from_icon_name("video-x-generic", Gtk.IconSize.DIALOG)
                return
            os.makedirs(CACHE_DIR, exist_ok=True)
            thumb = os.path.join(CACHE_DIR, "preview.png")
            seek = 0.0
            if self.info and self.info.get("duration"):
                seek = min(self.info["duration"] * 0.1, 10.0)
            cmd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-nostdin",
                   "-ss", f"{seek:.2f}", "-i", path, "-frames:v", "1",
                   "-vf", "scale=480:270:force_original_aspect_ratio=decrease", thumb]
            try:
                subprocess.run(cmd, timeout=20, check=True)
                self.preview.set_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file(thumb))
            except Exception:
                self.preview.set_from_icon_name("video-x-generic", Gtk.IconSize.DIALOG)

        # ----- edición (no se aplica nada hasta «Aplicar») -----

        def on_choose(self, *_args):
            dlg = Gtk.FileChooserDialog(title=_("Choose a video"), transient_for=self,
                                        action=Gtk.FileChooserAction.OPEN)
            dlg.add_buttons(_("_Cancel"), Gtk.ResponseType.CANCEL, _("_Open"), Gtk.ResponseType.ACCEPT)
            dlg.set_default_response(Gtk.ResponseType.ACCEPT)
            flt = Gtk.FileFilter()
            flt.set_name(_("Videos"))
            flt.add_mime_type("video/*")
            for ext in ("mp4", "m4v", "mkv", "webm", "mov", "avi", "ogv", "wmv", "mpg", "mpeg", "ts"):
                flt.add_pattern(f"*.{ext}")
                flt.add_pattern(f"*.{ext.upper()}")
            dlg.add_filter(flt)
            allf = Gtk.FileFilter()
            allf.set_name(_("All files"))
            allf.add_pattern("*")
            dlg.add_filter(allf)
            current = self.cfg.get("video")
            if current and os.path.isdir(os.path.dirname(current)):
                dlg.set_current_folder(os.path.dirname(current))
            else:
                videos = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_VIDEOS)
                dlg.set_current_folder(videos if videos and os.path.isdir(videos) else os.path.expanduser("~"))
            if dlg.run() == Gtk.ResponseType.ACCEPT:
                path = dlg.get_filename()
                dlg.destroy()
                self.select_video(path)
            else:
                dlg.destroy()

        def select_video(self, path):
            self.cfg["video"] = path
            self.load_video(path)
            self.refresh_status()

        def on_option_changed(self, *_args):
            if self._loading:
                return
            self.cfg["fit"] = self.fit_combo.get_active_id()
            self.cfg["quality"] = self.quality_combo.get_active_id()
            self.cfg["pause_when_covered"] = self.pause_switch.get_active()
            self.cfg["hwdec"] = self.hw_switch.get_active()
            self.refresh_status()

        # ----- Aplicar / Quitar vídeo -----

        def on_apply(self, *_args):
            if not self.video_ok():
                return
            save_config(self.cfg)
            self.applied = dict(self.cfg)
            if not set_extension_enabled(True):
                if desktop_backend() == "xfce":
                    self.message(_("The video could not be started."),
                                 _("The Xfce part of {app} is not installed "
                                   "(mintmotion-xfce is missing).").format(app=APP_NAME),
                                 Gtk.MessageType.ERROR)
                else:
                    self.message(_("Cinnamon was not found."),
                                 _("{app} works as an extension of the Cinnamon desktop.").format(app=APP_NAME),
                                 Gtk.MessageType.ERROR)
                return
            self.enabled = True
            self.last_spawn = GLib.get_monotonic_time()
            self.refresh_status()
            GLib.timeout_add(1500, self.refresh_status)

        def ensure_static_background(self):
            """Comprueba que hay un fondo estático al que volver; si el anterior ya
            no existe, pide una imagen. False si el usuario cancela."""
            if static_background_ok():
                return True
            r = self.ask(_("Your previous desktop background no longer exists"),
                         _("Choose an image to set as desktop background."),
                         [(_("_Cancel"), Gtk.ResponseType.CANCEL, None),
                          (_("_Choose image…"), Gtk.ResponseType.OK, "suggested-action")])
            if r != Gtk.ResponseType.OK:
                return False
            dlg = Gtk.FileChooserDialog(title=_("Choose a background image"), transient_for=self,
                                        action=Gtk.FileChooserAction.OPEN)
            dlg.add_buttons(_("_Cancel"), Gtk.ResponseType.CANCEL, _("_Open"), Gtk.ResponseType.ACCEPT)
            flt = Gtk.FileFilter()
            flt.set_name(_("Images"))
            flt.add_pixbuf_formats()
            dlg.add_filter(flt)
            pics = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
            start = pics if pics and os.path.isdir(pics) else (
                "/usr/share/backgrounds" if os.path.isdir("/usr/share/backgrounds") else os.path.expanduser("~"))
            dlg.set_current_folder(start)
            ok = dlg.run() == Gtk.ResponseType.ACCEPT
            path = dlg.get_filename() if ok else None
            dlg.destroy()
            if not path:
                return False
            return set_static_background(path)

        def on_remove_video(self, *_args):
            if not self.ensure_static_background():
                return
            set_extension_enabled(False)
            self.enabled = False
            self.refresh_status()

        # ----- Desinstalar -----

        def on_uninstall(self, *_args):
            r = self.ask(_("Uninstall {app}?").format(app=APP_NAME),
                         _("The program and all its settings will be removed. "
                           "The desktop will go back to a static background.") + "\n\n<b>" +
                         _("Your videos will not be touched.") + "</b>",
                         [(_("_Cancel"), Gtk.ResponseType.CANCEL, None),
                          (_("_Uninstall"), Gtk.ResponseType.OK, "destructive-action")],
                         Gtk.MessageType.WARNING)
            if r != Gtk.ResponseType.OK:
                return
            if not package_installed():
                self.message(_("{app} is not installed as a package").format(app=APP_NAME),
                             _("It seems to be installed from the source code. Uninstall it from that "
                               "folder with:") + "\n<tt>sudo make uninstall</tt>", Gtk.MessageType.ERROR)
                return
            if not shutil.which("pkexec"):
                self.message(_("pkexec is missing"),
                             _("Without pkexec I cannot ask for your password. Uninstall it from a "
                               "terminal with:") + f"\n<tt>sudo apt purge {PACKAGE}</tt>", Gtk.MessageType.ERROR)
                return

            # Vídeos creados por el propio programa: el usuario decide
            self.delete_videos = False
            vids = created_videos()
            if vids:
                total = sum(os.path.getsize(v) for v in vids)
                n = len(vids)
                r = self.ask(_("What should I do with the videos that {app} created?").format(app=APP_NAME),
                             ngettext("“Optimize for my screen” created <b>{n} video</b> ({size}) in",
                                      "“Optimize for my screen” created <b>{n} videos</b> ({size}) in",
                                      n).format(n=n, size=human_size(total)) + "\n"
                             f"<tt>{GLib.markup_escape_text(DATA_DIR.replace(os.path.expanduser('~'), '~', 1))}</tt>",
                             [(_("_Keep them"), Gtk.ResponseType.NO, None),
                              (_("_Delete them"), Gtk.ResponseType.YES, "destructive-action")])
                if r not in (Gtk.ResponseType.NO, Gtk.ResponseType.YES):
                    return
                self.delete_videos = r == Gtk.ResponseType.YES

            self.ensure_static_background()  # si cancela, se desinstala igualmente

            # El vídeo sigue mientras se pide la contraseña; solo se apaga si la
            # desinstalación sale bien (sin apagar y encender seguidos).
            self.busy = True
            self.status.set_markup(GLib.markup_escape_text(_("Uninstalling… enter your password if asked.")))
            self.update_buttons()
            try:
                self.pk_log = tempfile.TemporaryFile(mode="w+")  # sin tubería: no puede llenarse
                self.pk_proc = subprocess.Popen(["pkexec", "apt-get", "purge", "-y", PACKAGE],
                                                stdout=self.pk_log, stderr=subprocess.STDOUT, text=True)
            except OSError as e:
                self.uninstall_failed(str(e))
                return
            GLib.child_watch_add(GLib.PRIORITY_DEFAULT, self.pk_proc.pid, self.on_uninstall_done)

        def on_uninstall_done(self, pid, status):
            self.pk_proc.returncode = os.waitstatus_to_exitcode(status)  # ya recogido por GLib
            self.pk_log.seek(0)
            out = self.pk_log.read()
            self.pk_log.close()
            ok = os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 and not package_installed()
            if not ok:
                code = os.WEXITSTATUS(status) if os.WIFEXITED(status) else -1
                why = (GLib.markup_escape_text(_("You cancelled the password prompt.")) if code in (126, 127)
                       else GLib.markup_escape_text(out.strip()[-500:]))
                self.uninstall_failed(why)
                return
            set_extension_enabled(False)  # Cinnamon la descarga y cierra el vídeo (en Xfce, el supervisor)
            self.enabled = False
            remove_user_data(self.delete_videos)
            self.busy = False
            extra = "" if self.delete_videos or not created_videos() else \
                "\n\n" + _("The optimized videos are still in {folder}.").format(
                    folder=f"<tt>{GLib.markup_escape_text(DATA_DIR)}</tt>")
            self.message(_("{app} has been uninstalled").format(app=APP_NAME),
                         _("Nothing of the program remains on the computer.") + extra)
            self.app.quit()

        def uninstall_failed(self, why):
            self.busy = False
            self.refresh_status()
            self.message(_("It was not uninstalled"), why, Gtk.MessageType.ERROR)

        # ----- estado -----

        def revive_supervisor(self):
            """Xfce: si el vídeo está activado pero su supervisor no está en
            marcha (se cerró a la fuerza), se vuelve a lanzar. Como mucho una
            vez cada 15 s, por si no llega a arrancar."""
            if not self.enabled or desktop_backend() != "xfce" or xfce_daemon_pid():
                return
            now = GLib.get_monotonic_time()
            if now - self.last_spawn > 15 * 1000000:
                self.last_spawn = now
                set_extension_enabled(True)

        def refresh_status(self):
            if self.busy:
                return True
            self.enabled = extension_enabled()
            self.revive_supervisor()
            st = playback_status()
            esc = GLib.markup_escape_text
            if not self.enabled:
                txt = esc(_("No video: your static desktop background is shown."))
            elif st == "reproduciendo":
                txt = "<span foreground='#26a269'>●</span> " + esc(_("Playing on the desktop."))
            elif st == "pausado":
                txt = "<span foreground='#e5a50a'>●</span> " + esc(
                    _("Paused: the desktop is covered (it barely uses CPU)."))
            elif st == "dormido":
                txt = "<span foreground='#e5a50a'>●</span> " + esc(
                    _("Sleeping: the desktop has been covered for a while and the player was closed "
                      "to free its memory. When uncovered, it continues where it was."))
            elif st == "error":
                txt = "<span foreground='#c01c28'>●</span> " + esc(
                    _("The player has failed several times (check {log}).").format(log=log_hint()))
            else:
                txt = "<span foreground='#c01c28'>●</span> " + esc(
                    _("Starting… (if this does not change, check {log})").format(log=log_hint()))
            if self.pending() and self.video_ok():
                txt += "\n<span foreground='#1c71d8'>" + esc(
                    _("There are changes not applied yet: press “Apply”.")) + "</span>"
            elif not self.enabled and self.video_ok():
                txt += " " + esc(_("Press “Apply” to set the video."))
            self.status.set_markup(txt)
            self.update_usage()
            self.update_buttons()
            return True

        def update_usage(self):
            u = self.meter.sample() if self.enabled else None
            if not u and self.enabled and playback_status() == "dormido":
                u = {"cpu_core": 0.0, "cpu_total": 0.0, "ram_kb": 0, "ram_pct": 0.0}
            if not u:
                self.usage.hide()
                return
            self.usage.show()
            if u["cpu_total"] is None:
                self.cpu_bar.set_value(0)
                self.cpu_text.set_text(_("measuring…"))
            else:
                self.cpu_bar.set_value(min(u["cpu_total"], 100))
                n = self.meter.ncpu
                self.cpu_text.set_text(
                    # xgettext: no-python-format
                    ngettext("{total}% of total · {core}% of one core ({n} core)",
                             "{total}% of total · {core}% of one core ({n} cores)", n).format(
                        total=fmt_num(u["cpu_total"]), core=fmt_num(u["cpu_core"]), n=n))
            self.ram_bar.set_value(min(u["ram_pct"], 100))
            self.ram_text.set_text(
                # xgettext: no-python-format
                _("{used} of {total} · {pct}%").format(
                    used=human_size(u["ram_kb"] * 1024), total=human_size(self.meter.ram_total * 1024),
                    pct=fmt_num(u["ram_pct"])))

        # ----- optimización -----

        def on_optimize(self, *_args):
            src = self.cfg.get("video")
            sw, sh = screen_size()
            if not src or not sw:
                return
            os.makedirs(DATA_DIR, exist_ok=True)
            base = os.path.splitext(os.path.basename(src))[0]
            fit = self.cfg.get("fit", "rellenar")
            self.opt_dst = os.path.join(DATA_DIR, f"{base}-{sw}x{sh}-{fit}.mp4")
            self.opt_tmp = self.opt_dst + ".part.mp4"
            cmd = optimized_command(src, self.opt_tmp, sw, sh,
                                    (self.info or {}).get("fps", 0), fit)
            self.ff_proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                            text=True, bufsize=1)
            self.opt_button.set_sensitive(False)
            self.opt_progress.set_fraction(0)
            # xgettext: no-python-format
            self.opt_progress.set_text(_("Optimizing… {pct}%").format(pct=0))
            self.opt_progress.show()
            self.opt_cancel.show()
            self.update_buttons()
            GLib.io_add_watch(self.ff_proc.stdout, GLib.PRIORITY_DEFAULT,
                              GLib.IO_IN | GLib.IO_HUP, self.on_ff_output)

        def on_ff_output(self, stream, cond):
            line = stream.readline() if cond & GLib.IO_IN else ""
            if line:
                key, _sep, val = line.strip().partition("=")
                dur = (self.info or {}).get("duration") or 0
                if key == "out_time_us" and dur and val.isdigit():
                    frac = min(int(val) / 1e6 / dur, 1.0)
                    self.opt_progress.set_fraction(frac)
                    # xgettext: no-python-format
                    self.opt_progress.set_text(_("Optimizing… {pct}%").format(pct=f"{frac * 100:.0f}"))
                return True
            rc = self.ff_proc.wait() if self.ff_proc else -1
            err = self.ff_proc.stderr.read() if self.ff_proc else ""
            self.ff_proc = None
            self.opt_button.set_sensitive(True)
            self.opt_progress.hide()
            self.opt_cancel.hide()
            if rc == 0 and os.path.isfile(self.opt_tmp):
                os.replace(self.opt_tmp, self.opt_dst)
                self.select_video(self.opt_dst)
            else:
                try:
                    os.unlink(self.opt_tmp)
                except OSError:
                    pass
                if rc not in (-15, 255):  # no fue una cancelación
                    self.message(_("The video could not be optimized."),
                                 GLib.markup_escape_text(err.strip()[-600:]), Gtk.MessageType.ERROR)
            self.update_buttons()
            return False

        def on_optimize_cancel(self, *_args):
            if self.ff_proc:
                self.ff_proc.terminate()

        def on_destroy(self, *_args):
            if self.ff_proc:
                self.ff_proc.terminate()

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID)

        def do_activate(self):
            win = self.get_active_window() or Window(self)
            win.show_all()
            win.present()

    GLib.set_application_name(APP_NAME)
    return App().run([sys.argv[0]])


# ---------------------------------------------------------------------------
# Línea de órdenes
# ---------------------------------------------------------------------------

def main():
    p = argparse.ArgumentParser(
        prog="mintmotion",
        description=_("{app}: video as desktop background in Cinnamon and Xfce. Without arguments "
                      "it opens the settings window.").format(app=APP_NAME))
    p.add_argument("--video", help=_("video to use as background (it also enables it)"))
    p.add_argument("--fit", choices=[k for k, _t in FITS], help=_("screen fit"))
    p.add_argument("--quality", choices=[k for k, _t in QUALITIES], help=_("scaling quality"))
    p.add_argument("--pause-when-covered", choices=["si", "yes", "no"],
                   help=_("pause when the desktop is covered"))
    p.add_argument("--hwdec", choices=["si", "yes", "no"], help=_("hardware decoding"))
    p.add_argument("--enable", action="store_true", help=_("set the video as background"))
    p.add_argument("--disable", action="store_true", help=_("remove the video background"))
    p.add_argument("--status", action="store_true", help=_("show the status"))
    args = p.parse_args()

    try:
        cleanup_old_install()
        migrate_legacy()
    except Exception as e:  # la migración nunca debe impedir arrancar
        print("mintmotion: " + _("could not migrate the previous version: {error}").format(error=e),
              file=sys.stderr)

    if not any([args.video, args.fit, args.quality, args.pause_when_covered, args.hwdec,
                args.enable, args.disable, args.status]):
        return run_gui()

    cfg = load_config()
    changed = False
    if args.video:
        path = os.path.abspath(os.path.expanduser(args.video))
        if not os.path.isfile(path):
            print(_("Does not exist: {path}").format(path=path), file=sys.stderr)
            return 1
        cfg["video"] = path
        args.enable = True
        changed = True
    if args.fit:
        cfg["fit"] = args.fit
        changed = True
    if args.quality:
        cfg["quality"] = args.quality
        changed = True
    if args.pause_when_covered:
        cfg["pause_when_covered"] = args.pause_when_covered != "no"
        changed = True
    if args.hwdec:
        cfg["hwdec"] = args.hwdec != "no"
        changed = True
    if changed:
        save_config(cfg)
    if args.enable or args.disable:
        if not set_extension_enabled(bool(args.enable)):
            if desktop_backend() == "xfce":
                print(_("The Xfce part of {app} is not installed "
                        "(mintmotion-xfce is missing).").format(app=APP_NAME), file=sys.stderr)
            else:
                print(_("Cinnamon was not found (org.cinnamon schema)."), file=sys.stderr)
            return 1
    if args.status:
        yes, no = _("yes"), _("no")
        st = playback_status()
        print(_("enabled: {value}").format(value=yes if extension_enabled() else no))
        print(_("video: {value}").format(value=cfg["video"] or _("(none)")))
        print(_("fit: {fit} · quality: {quality} · hardware: {hw} · pause when covered: {pause}").format(
            fit=cfg["fit"], quality=cfg["quality"], hw=yes if cfg["hwdec"] else no,
            pause=yes if cfg["pause_when_covered"] else no))
        print(_("state: {value}").format(value=_(STATES.get(st, st))))
    return 0


if __name__ == "__main__":
    sys.exit(main())
