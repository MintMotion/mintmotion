def _read_config(path):
    cfg = dict(DEFAULTS)
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict):
            # también las claves que la ventana no muestra (sleep_after,
            # ram_limit_mb…): hay que conservarlas al guardar
            cfg.update(data)
    except (OSError, ValueError):
        pass
    return cfg


def load_config():
    return _read_config(CONFIG_FILE)


def save_config(cfg):
    """Escritura atómica: la extensión nunca lee un archivo a medias."""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=CONFIG_DIR, prefix=".config-", suffix=".json")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2)
    os.replace(tmp, CONFIG_FILE)


def _settings(schema):
    try:
        from gi.repository import Gio
    except ImportError:
        return None
    src = Gio.SettingsSchemaSource.get_default()
    if not src or not src.lookup(schema, True):
        return None
    return Gio.Settings.new(schema)


def _sync_settings():
    from gi.repository import Gio
    Gio.Settings.sync()


_backend = False


def desktop_backend():
    """Escritorio de la sesión: "cinnamon", "xfce" o None (no soportado)."""
    global _backend
    if _backend is False:
        cur = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
        if "cinnamon" in cur:
            _backend = "cinnamon"
        elif "xfce" in cur:
            _backend = "xfce"
        elif cur:
            _backend = None
        else:
            # Sin la variable (ssh, cron…): se deduce de lo que hay instalado.
            _backend = "xfce" if (not _settings("org.cinnamon") and shutil.which("xfdesktop")) \
                else "cinnamon"
    return _backend


def xfce_daemon_path():
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(here, "mintmotion-xfce"),                              # código fuente
                 os.path.join(here, "..", "lib", "mintmotion", "mintmotion-xfce"),   # PREFIX=...
                 "/usr/lib/mintmotion/mintmotion-xfce", "/usr/local/lib/mintmotion/mintmotion-xfce"):
        if os.path.isfile(path):
            return os.path.normpath(path)
    return None


def xfce_daemon_pid():
    """PID del supervisor de Xfce si está en marcha; si no, None."""
    try:
        with open(XFCE_PID_FILE, encoding="utf-8") as f:
            pid = int(f.read().strip())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return pid if b"mintmotion-xfce" in f.read() else None
    except (OSError, ValueError):
        return None


def _xfce_set_enabled(enabled):
    daemon = xfce_daemon_path()
    if enabled:
        if not daemon:
            return False
        was_enabled = os.path.exists(XFCE_ENABLED_FILE)
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(XFCE_ENABLED_FILE, "w", encoding="utf-8"):
            pass
        if was_enabled and xfce_daemon_pid():
            return True   # ya está en marcha: lee solo los cambios de configuración
        try:
            # Si queda una instancia cerrándose, la nueva espera a que termine.
            subprocess.Popen([daemon], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            return False
        return True
    try:
        os.unlink(XFCE_ENABLED_FILE)   # el supervisor lo ve, devuelve el fondo y termina
    except OSError:
        pass
    if daemon and not xfce_daemon_pid():
        # No hay supervisor (¿se cerró a la fuerza?): si dejó el fondo de
        # xfdesktop en su color de trabajo, se devuelve el del usuario.
        try:
            subprocess.run([daemon, "--restore"], stdin=subprocess.DEVNULL, timeout=15)
        except (OSError, subprocess.SubprocessError):
            pass
    return True


def extension_enabled():
    if desktop_backend() == "xfce":
        return os.path.exists(XFCE_ENABLED_FILE)
    s = _settings("org.cinnamon")
    return bool(s) and UUID in s.get_strv("enabled-extensions")


def set_extension_enabled(enabled):
    if desktop_backend() == "xfce":
        return _xfce_set_enabled(enabled)
    s = _settings("org.cinnamon")
    if not s:
        return False
    current = [u for u in s.get_strv("enabled-extensions") if u not in (UUID, LEGACY_UUID)]
    if enabled:
        current.append(UUID)
    s.set_strv("enabled-extensions", current)
    _sync_settings()
    return True


