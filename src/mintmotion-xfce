class Daemon:
    ATOMS = ("XFCE_DESKTOP_WINDOW", "_NET_CLIENT_LIST", "_NET_CLIENT_LIST_STACKING", "_NET_CURRENT_DESKTOP",
             "_NET_NUMBER_OF_DESKTOPS", "_NET_ACTIVE_WINDOW", "_NET_SHOWING_DESKTOP",
             "_NET_SUPPORTING_WM_CHECK", "_NET_WM_WINDOW_TYPE", "_NET_WM_WINDOW_TYPE_DESKTOP",
             "_NET_WM_WINDOW_TYPE_DOCK", "_NET_WM_WINDOW_TYPE_NORMAL", "_NET_WM_WINDOW_TYPE_DIALOG",
             "_NET_WM_WINDOW_TYPE_UTILITY", "_NET_WM_STATE", "_NET_WM_STATE_HIDDEN",
             "_NET_WM_STATE_SHADED", "_NET_WM_STATE_FULLSCREEN", "_NET_WM_STATE_STICKY",
             "_NET_WM_STATE_SKIP_TASKBAR", "_NET_WM_STATE_SKIP_PAGER", "_NET_WM_STATE_BELOW",
             "_NET_WM_DESKTOP", "_NET_WM_WINDOW_OPACITY",
             "_NET_WM_STRUT", "_NET_WM_STRUT_PARTIAL", "_GTK_FRAME_EXTENTS",
             "_NET_WM_BYPASS_COMPOSITOR", "_MOTIF_WM_HINTS", "_NET_WM_NAME", "UTF8_STRING")

    def __init__(self):
        self.d = display.Display()
        self.x_ok = True
        self.screen_num = self.d.get_default_screen()
        self.screen = self.d.screen()
        self.root = self.screen.root
        self.d.set_error_handler(self._x_error)
        if not self.d.has_extension("SHAPE"):
            raise SystemExit("mintmotion: the X server has no SHAPE extension")
        self.a = {name: self.d.intern_atom(name) for name in self.ATOMS}
        self.a_cm = self.d.intern_atom(f"_NET_WM_CM_S{self.screen_num}")
        self.a_lock = self.d.intern_atom(f"_MINTMOTION_S{self.screen_num}")
        a = self.a
        self.covering_types = {a["_NET_WM_WINDOW_TYPE_NORMAL"], a["_NET_WM_WINDOW_TYPE_DIALOG"],
                               a["_NET_WM_WINDOW_TYPE_UTILITY"]}
        self.relevant = {a[n] for n in ("_NET_WM_WINDOW_TYPE", "_NET_WM_STATE", "_NET_WM_DESKTOP",
                                        "_NET_WM_WINDOW_OPACITY",
                                        "_NET_WM_STRUT", "_NET_WM_STRUT_PARTIAL", "_GTK_FRAME_EXTENTS")}

        # Una sola instancia por pantalla: una selección X hace de cerrojo y
        # se libera sola si este proceso muere.
        self.lock_win = self.root.create_window(-10, -10, 1, 1, 0, X.CopyFromParent, X.InputOnly)
        for _ in range(30):
            if self.d.get_selection_owner(self.a_lock) == X.NONE:
                break
            time.sleep(0.2)   # puede ser una instancia que se está cerrando (tarda hasta 5 s)
        else:
            raise SystemExit(0)   # ya hay un supervisor en marcha
        self.lock_win.set_selection_owner(self.a_lock, X.CurrentTime)
        self.d.sync()
        owner = self.d.get_selection_owner(self.a_lock)
        if owner == X.NONE or owner.id != self.lock_win.id:
            raise SystemExit(0)

        # Formato de imagen del servidor: la máscara necesita 32 bits por píxel
        info = self.d.display.info
        bpp = {f.depth: f.bits_per_pixel for f in info.pixmap_formats}
        self.lsb_first = info.image_byte_order == X.LSBFirst
        self.can_mask = (bpp.get(self.screen.root_depth) == 32 and
                         info.bitmap_format_bit_order == info.image_byte_order and
                         info.bitmap_format_scanline_pad == 32)
        self.matcher = KeyMatcher(self.lsb_first)
        self.lanes = Lanes()
        # Visual de 32 bits (ARGB) para la capa de iconos
        self.vis32 = None
        # Solo con el formato habitual: 8 bits por canal y orden rojo-verde-azul
        root_ok = self.screen.root_depth == 24 and any(
            v.visual_id == self.screen.root_visual and v.red_mask == 0xff0000 and v.blue_mask == 0xff
            for dp in self.screen.allowed_depths if dp.depth == 24 for v in dp.visuals)
        if root_ok and self.can_mask and self.lsb_first and bpp.get(32) == 32:
            for dp in self.screen.allowed_depths:
                if dp.depth == 32:
                    for v in dp.visuals:
                        if v.visual_class == X.TrueColor and v.red_mask == 0xff0000 and \
                                v.green_mask == 0xff00 and v.blue_mask == 0xff:
                            self.vis32 = v.visual_id
                            break
        self.cmap32 = None
        self.alpha = False        # iconos con transparencia real (hace falta compositor)
        self.phase = None         # midiendo: None | "white" | "black"
        self.phase_t = 0.0
        self.probe_base = 0
        self.probe_px = 0
        self.refine_id = 0
        self.refine_fails = 0
        self.refine_times = []
        self.probe_snapshot = None
        # DAMAGE y Composite rechazan cualquier petición hasta que el cliente
        # dice qué versión habla.
        self.have_damage = self.have_composite = False
        try:
            if self.d.has_extension("DAMAGE") and hasattr(self.root, "damage_create"):
                self.d.damage_query_version()
                self.have_damage = True
        except Exception:
            pass
        try:
            if self.d.has_extension("Composite") and hasattr(self.root, "composite_redirect_window"):
                self.d.composite_query_version()
                self.have_composite = True
        except Exception:
            pass
        self.damage_event = self.d.extension_event.DamageNotify if self.have_damage else None
        self.have_dpms = self.d.has_extension("DPMS") and hasattr(self.d, "dpms_info")
        self.randr_event = None

        self.loop = GLib.MainLoop()
        self.config = read_config()
        self.config_stamp = self._config_stamp()
        self.argv = None          # opciones de mpv preparadas por mintmotion-renderer
        self.prepare_gen = 0
        self.players = []
        self.own = {}             # id de ventana propia -> Player
        self.clients = {}         # id de ventana gestionada -> WinInfo
        self.frames = {}          # id de cliente -> ventana de nivel superior (marco)
        self.desks = {}           # id -> DesktopWindow
        self.or_windows = {}      # ventanas sin gestionar visibles: id -> (x, y, w, h, profundidad)
        self.redirected = {}      # ventanas redirigidas por nosotros (sin compositor)
        self.monitors = []
        self.root_size = (self.screen.width_in_pixels, self.screen.height_in_pixels)
        self.seq = 0
        self.stopping = False
        self.hiding = False       # cerrando: el vídeo tapa los iconos hasta que vuelve el fondo
        self.timeouts = set()
        self.update_id = 0
        self.mask_id = 0
        self.trim_id = 0
        self.monitors_id = 0
        self.config_id = 0
        self.backdrop_id = 0
        self.reasserts = []
        self.keyed_at = 0.0
        self.screensaver = False
        self.session_inactive = False
        self.display_off = False
        self.inactive_translucent = False
        self.last_state = None
        self.last_sockets = None
        self.polls = 0

        self.xfconf = Xfconf()
        self.backdrop = Backdrop(self.xfconf, self.screen_num)
        self.alpha = self._alpha_possible()
        self.backdrop.key = KEY_BLACK if self.alpha else KEY_RGB
        self._watch_dbus()

        self.root.change_attributes(event_mask=X.PropertyChangeMask | X.SubstructureNotifyMask |
                                    X.StructureNotifyMask)
        try:
            from Xlib.ext import randr
            self.d.xrandr_query_version()
            self.root.xrandr_select_input(randr.RRScreenChangeNotifyMask)
            self.randr_event = self.d.extension_event.ScreenChangeNotify
        except Exception:
            pass
        GLib.io_add_watch(self.d.fileno(), GLib.PRIORITY_DEFAULT,
                          GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._x_ready)

        # Vigilancia de la configuración y del interruptor «xfce-enabled»
        os.makedirs(CONFIG_DIR, exist_ok=True)
        self.monitor = Gio.File.new_for_path(CONFIG_DIR).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor.connect("changed", self._config_dir_changed)

        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, self._on_signal)

        GLib.timeout_add_seconds(POLL_SECONDS, lambda: self.guard(self._poll) or True)
        GLib.timeout_add_seconds(HEALTH_EVERY_S,
                                 lambda: self.guard(lambda: [p.check_health() for p in self.players]) or True)
        GLib.timeout_add_seconds(RAM_EVERY_S,
                                 lambda: self.guard(lambda: [p.check_ram() for p in self.players]) or True)

        write_atomic(PID_FILE, str(os.getpid()))
        self.guard(self._startup, 0)

    # ---------- utilidades ----------

    def next_seq(self):
        self.seq += 1
        return self.seq

    def guard(self, fn, *args):
        """Ejecuta fn y después entrega los eventos X que hayan quedado en la
        cola de Xlib (los que llegaron mientras se esperaba una respuesta).
        Ningún fallo inesperado debe tumbar el supervisor."""
        try:
            fn(*args)
            if self.x_ok:
                self._drain()
        except xerror.ConnectionClosedError:
            self._x_lost()
        except (BrokenPipeError, ConnectionResetError):
            self._x_lost()
        except Exception:
            import traceback
            log("unexpected error:\n" + traceback.format_exc())
        return None

    def timeout(self, ms, fn, *args):
        box = []

        def fire():
            self.timeouts.discard(box[0])
            self.guard(fn, *args)
            return False

        box.append(GLib.timeout_add(ms, fire))
        self.timeouts.add(box[0])
        return box[0]

    def cancel(self, tid):
        if tid in self.timeouts:
            self.timeouts.discard(tid)
            GLib.source_remove(tid)

    def _x_error(self, err, request):
        pass   # ventanas que desaparecen mientras se las consulta: es normal

    def _x_ready(self, fd, cond):
        if cond & (GLib.IO_HUP | GLib.IO_ERR):
            self._x_lost()
            return False
        self.guard(lambda: None)
        return self.x_ok

    def _drain(self):
        d = self.d
        while True:
            d.flush()
            n = d.pending_events()
            if not n:
                return
            for _ in range(n):
                self._event(d.next_event())

    def prop(self, win, name):
        """Valor de una propiedad de 32 bits como lista de enteros, o None."""
        try:
            p = win.get_full_property(self.a[name], X.AnyPropertyType)
        except xerror.XError:
            return None
        if p is None or p.format != 32:
            return None
        return list(p.value)

    def toplevel(self, win):
        """Ventana de nivel superior que contiene a «win» (el marco que le
        pone el gestor de ventanas, o ella misma)."""
        f = self.frames.get(win.id)
        if f is not None:
            return f
        try:
            cur = win
            for _ in range(8):
                parent = cur.query_tree().parent
                if parent == X.NONE or parent.id == self.root.id:
                    break
                cur = parent
        except xerror.XError:
            return None
        self.frames[win.id] = cur
        return cur

    # ---------- arranque ----------

    def _startup(self, tries):
        if not os.path.exists(ENABLED_FILE):
            self.quit()
            return
        # Al iniciar sesión puede que el gestor de ventanas aún no esté listo
        if tries < 30 and not self.prop(self.root, "_NET_SUPPORTING_WM_CHECK"):
            self.timeout(500, self._startup, tries + 1)
            return
        log(f"supervisor started (pid {os.getpid()})")
        log("icons: real transparency (compositor found)" if self.alpha else
            "icons: cut-out mask (no compositor)")
        debug(f"memory at start: {process_pss_kb(os.getpid())} KB (PSS)")
        self._read_wm_settings()
        self._scan_unmanaged()
        self._sync_clients()
        self.monitors = self._read_monitors()
        self._prepare()

    def _prepare(self):
        """Pide a mintmotion-renderer las opciones de mpv para este vídeo
        (adaptadas al mpv instalado). No bloquea."""
        self.prepare_gen += 1
        gen = self.prepare_gen
        self.argv = None
        video = self.config.get("video")
        if not video or not os.path.isfile(video):
            log(f"no video configured, or it does not exist: {video}")
            for p in self.players:
                p.destroy()
            self.players = []
            self.players_changed()
            return
        here = os.path.dirname(os.path.realpath(__file__))
        renderer = os.path.join(here, "mintmotion-renderer")
        if not os.path.exists(renderer):
            renderer = SYSTEM_RENDERER
        cmd = ["/usr/bin/python3", renderer, "--video", video, "--width", "1", "--height", "1",
               "--token", "x", "--fit", str(self.config.get("fit")),
               "--quality", str(self.config.get("quality")), "--print-mpv-args"]
        try:
            proc = Gio.Subprocess.new(cmd, Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as e:
            log(f"could not launch the renderer: {e.message}")
            return

        def done(p, res):
            try:
                out = p.communicate_utf8_finish(res)[1] or ""
            except GLib.Error:
                out = ""
            self.guard(self._prepared, gen, out)

        proc.communicate_utf8_async(None, None, done)

    def _prepared(self, gen, out):
        if gen != self.prepare_gen or self.stopping:
            return
        lines = out.split("\n")
        if lines and lines[-1] == "":
            lines.pop()
        if len(lines) < 3 or lines[0] != "mpv" or "--" not in lines:
            log("the renderer could not prepare the mpv options")
            self.write_state("error")
            return
        dd = lines.index("--")
        self.argv = lines[:dd + 1] + ["\n".join(lines[dd + 1:])]   # la ruta puede llevar saltos de línea
        if self.players:
            for p in self.players:
                p.failed = False
                p.restart_times = []
                p.reset_decoder()
                p.relaunch(keep_pos=False)
        self._sync_players()

    # ---------- monitores y reproductores ----------

    def _read_monitors(self):
        mons = []
        try:
            res = self.root.xrandr_get_monitors()
            stamp = None
            for m in res.monitors:
                if m.width_in_pixels <= 0 or m.height_in_pixels <= 0:
                    continue
                # xfdesktop nombra sus ajustes con el nombre de la primera salida
                name = None
                try:
                    if m.crtcs:
                        if stamp is None:
                            stamp = self.root.xrandr_get_screen_resources_current().config_timestamp
                        name = self.d.xrandr_get_output_info(m.crtcs[0], stamp).name
                    if not name:
                        name = self.d.get_atom_name(m.name)
                except Exception:
                    name = None
                mons.append(Monitor(name, m.x, m.y, m.width_in_pixels, m.height_in_pixels))
        except Exception:
            mons = []
        if not mons:
            w, h = self.root_size
            mons = [Monitor(None, 0, 0, w, h)]
        # Monitores duplicados (modo espejo) o contenidos en otro: uno solo
        out = []
        for m in sorted(mons, key=lambda m: -(m.w * m.h)):
            if not any(o.x <= m.x and o.y <= m.y and o.x + o.w >= m.x + m.w and o.y + o.h >= m.y + m.h
                       for o in out):
                out.append(m)
        out.sort(key=lambda m: (m.x, m.y))
        return out

    def _monitors_changed_soon(self):
        if not self.monitors_id:
            self.monitors_id = self.timeout(1000, self._monitors_changed)

    def _monitors_changed(self):
        self.monitors_id = 0
        try:
            g = self.root.get_geometry()
            self.root_size = (g.width, g.height)
        except xerror.XError:
            pass
        mons = self._read_monitors()
        if [(m.name, m.rect) for m in mons] != [(m.name, m.rect) for m in self.monitors]:
            self.monitors = mons
            self._sync_players()

    def _sync_players(self):
        """Un reproductor por monitor; los que ya estaban y no han cambiado se conservan."""
        if self.stopping or self.argv is None:
            return
        old = {p.mon.rect: p for p in self.players}
        players = []
        for m in self.monitors:
            p = old.pop(m.rect, None)
            if p is not None:
                p.mon.name = m.name
            else:
                p = Player(self, m)
                p.start()
            players.append(p)
        for p in old.values():
            p.destroy()
        self.players = players
        self.players_changed()

    def create_overlay_window(self, mon, token):
        """Ventana ARGB del tamaño del monitor para los iconos. Mismos
        atributos que la del vídeo: misma capa, sin foco y sin entrada."""
        if self.cmap32 is None:
            self.cmap32 = self.root.create_colormap(self.vis32, X.AllocNone)
        win = self.root.create_window(
            mon.x, mon.y, mon.w, mon.h, 0, 32, X.InputOutput, self.vis32,
            background_pixel=0, border_pixel=0, colormap=self.cmap32,
            event_mask=X.StructureNotifyMask | X.ExposureMask)
        self._window_hints(win, mon, f"MintMotion icons {token}", "mintmotion-icons")
        return win

    def create_video_window(self, mon, token):
        win = self.root.create_window(
            mon.x, mon.y, mon.w, mon.h, 0, self.screen.root_depth, X.InputOutput, X.CopyFromParent,
            background_pixmap=X.NONE,   # sin fondo: conserva el último fotograma
            event_mask=X.StructureNotifyMask)
        self._window_hints(win, mon, f"MintMotion {token}", WM_CLASS)
        return win

    def _window_hints(self, win, mon, title, wm_class):
        a = self.a
        win.set_wm_name(title)
        win.change_property(a["_NET_WM_NAME"], a["UTF8_STRING"], 8, title.encode("utf-8"))
        win.set_wm_class(wm_class, wm_class)
        win.set_wm_hints(flags=1, input=0)   # InputHint, input = False: nunca acepta el foco
        win.set_wm_normal_hints(flags=(1 | 2 | 4 | 16 | 32),   # USPosition|USSize|PPosition|PMinSize|PMaxSize
                                x=mon.x, y=mon.y, width=mon.w, height=mon.h,
                                min_width=mon.w, min_height=mon.h, max_width=mon.w, max_height=mon.h)
        # Tipo escritorio + «por debajo»: xfwm4 la pone en la capa «below»,
        # entre el escritorio y las ventanas normales, sin bordes ni sombra,
        # fuera de la lista de ventanas y de Alt+Tab.
        win.change_property(a["_NET_WM_WINDOW_TYPE"], Xatom.ATOM, 32, [a["_NET_WM_WINDOW_TYPE_DESKTOP"]])
        win.change_property(a["_NET_WM_STATE"], Xatom.ATOM, 32, [
            a["_NET_WM_STATE_STICKY"], a["_NET_WM_STATE_SKIP_TASKBAR"],
            a["_NET_WM_STATE_SKIP_PAGER"], a["_NET_WM_STATE_BELOW"]])
        win.change_property(a["_NET_WM_DESKTOP"], Xatom.CARDINAL, 32, [0xFFFFFFFF])
        # 2 = no desviar nunca del compositor
        win.change_property(a["_NET_WM_BYPASS_COMPOSITOR"], Xatom.CARDINAL, 32, [2])
        win.change_property(a["_MOTIF_WM_HINTS"], a["_MOTIF_WM_HINTS"], 32, [2, 0, 0, 0, 0])   # sin decoraciones
        # Región de entrada vacía: los clics y la rueda la atraviesan y llegan
        # a xfdesktop, que sigue funcionando igual (menú, iconos, arrastrar…).
        win.shape_rectangles(shape.SO.Set, shape.SK.Input, X.Unsorted, 0, 0, [])
        self.d.sync()

    # ---------- capa de iconos: modo y medición de la transparencia ----------

    def _alpha_possible(self):
        """La capa de iconos necesita un compositor (xfwm4 con el suyo
        activado, picom…) que mezcle la ventana ARGB con el vídeo."""
        if self.vis32 is None or os.environ.get("MINTMOTION_NO_ALPHA"):
            return False
        try:
            return self.d.get_selection_owner(self.a_cm) != X.NONE
        except xerror.XError:
            return False

    def _check_mode(self):
        want = self._alpha_possible()
        if want == self.alpha or self.stopping:
            return
        self.alpha = want
        log("compositor found: icons with real transparency" if want else
            "compositor gone: icons with the cut-out mask")
        self._refine_reset()
        self.backdrop.set_key(KEY_BLACK if want else KEY_RGB)
        for p in self.players:
            if want:
                p.make_overlay()
            else:
                p.drop_overlay()
                p.sigs, p.mask = {}, None
        self._sync_redirects()
        self._all_dirty()

    def _check_stacking(self):
        """Los iconos tienen que ir justo encima de su vídeo."""
        if not self.alpha:
            return
        st = self.prop(self.root, "_NET_CLIENT_LIST_STACKING") or []
        pos = {w: i for i, w in enumerate(st)}
        for p in self.players:
            if p.ov is not None and p.shown and p.settled:
                i, j = pos.get(p.win.id), pos.get(p.ov.id)
                if i is not None and j is not None and j != i + 1:
                    p.settle()

    def capture_strip(self, m, y, rows, fill):
        """Lo que pinta xfdesktop en una franja del monitor, como una imagen
        de 32 bits por píxel («fill» donde no llega) con el cuarto byte a
        cero: el servidor no garantiza qué deja en él."""
        shots = [s for s in (dw.capture(m, y, rows) for dw in self.desks.values()
                             if dw.keyed and dw.overlaps(m)) if s is not None]
        if not shots:
            return None
        n = m.w * rows
        if len(shots) == 1 and shots[0][2] == m.w and shots[0][3] == rows:
            buf = bytearray(shots[0][4])
        else:
            buf = bytearray(bytes((fill,)) * (n * 4))
            for ix0, iy0, iw, ih, raw in shots:
                for r in range(ih):
                    o = ((iy0 - m.y - y + r) * m.w + ix0 - m.x) * 4
                    buf[o:o + iw * 4] = raw[r * iw * 4:(r + 1) * iw * 4]
        buf[3::4] = bytes(n)
        return buf

    def capture_foreign(self, m, y, rows):
        """Lo que pintan en la franja las ventanas de escritorio que no son
        de xfdesktop: [(x0, y0, ancho, alto, datos, profundidad)]."""
        out = []
        for dw in self.desks.values():
            if not dw.keyed and dw.overlaps(m):
                s = dw.capture(m, y, rows)
                if s is not None:
                    out.append(s + (dw.depth,))
        return out

    def _probe_rows(self):
        """Tres filas de cada ventana de xfdesktop."""
        out = []
        for dw in self.desks.values():
            if dw.rect is None or not dw.keyed:
                continue
            w, h = dw.rect[2], dw.rect[3]
            for f in (1, 2, 3):
                try:
                    raw = dw.win.get_image(0, h * f // 4, w, 1, X.ZPixmap, 0xffffffff).data
                except xerror.XError:
                    continue
                if len(raw) == w * 4:
                    out.append(raw)
        return out

    def _probe(self, rgb):
        """Cuántos píxeles de esas filas son exactamente negros (o blancos)."""
        total = px = 0
        for raw in self._probe_rows():
            w = len(raw) // 4
            b, g, r = (int.from_bytes(raw[i::4], "little") for i in (0, 1, 2))
            if rgb == KEY_BLACK:
                total += (b | g | r).to_bytes(w, "little").count(0)
            else:
                total += (b & g & r).to_bytes(w, "little").count(255)
            px += w
        self.probe_px = px
        return total

    def keyed(self):
        """¿Muestra xfdesktop el color llave negro?"""
        if not self.backdrop.backup:
            return False
        n = self._probe(KEY_BLACK)
        return self.probe_px > 0 and n >= MIN_VISIBLE * self.probe_px

    def request_refine(self):
        if self.stopping or not self.alpha:
            return
        if self.refine_id:
            self.cancel(self.refine_id)
        # Medir repinta xfdesktop dos veces y escribe en xfconf: si algo
        # cambia sin parar, se espera más entre una medición y la siguiente.
        now = time.monotonic()
        self.refine_times = [t for t in self.refine_times if now - t < 10]
        busy = len(self.refine_times) >= 8
        self.refine_id = self.timeout(REFINE_BUSY_MS if busy else REFINE_QUIET_MS, self._refine_start)

    def _refine_reset(self):
        if self.refine_id:
            self.cancel(self.refine_id)
            self.refine_id = 0
        self.phase = None
        self.refine_fails = 0
        for p in self.players:
            p.wshots = {}

    def _refine_start(self):
        self.refine_id = 0
        if self.stopping or not self.alpha or self.phase:
            return
        if not any(p.pending for p in self.players):
            return
        base = self._probe(KEY_BLACK)
        if not self.probe_px or base < MIN_VISIBLE * self.probe_px:
            return   # sin llave a la vista; se volverá a pedir cuando xfdesktop repinte
        self.refine_times.append(time.monotonic())
        self.probe_base = base
        self.phase = "white"
        self.phase_t = time.monotonic()
        self.backdrop.set_key(KEY_WHITE)
        self.timeout(10, self._refine_poll)

    def _refine_poll(self):
        if not self.phase or self.stopping:
            return
        white = self.phase == "white"
        if self._probe(KEY_WHITE if white else KEY_BLACK) < 0.9 * self.probe_base:
            if time.monotonic() - self.phase_t > REFINE_TIMEOUT_S:
                self._refine_abort()
            else:
                self.timeout(10, self._refine_poll)
            return
        if white:
            for p in self.players:
                p.capture_white()
            self.phase = "black"
            self.phase_t = time.monotonic()
            self.backdrop.set_key(KEY_BLACK)
            self.timeout(10, self._refine_poll)
            return
        self.phase = None
        self.refine_fails = 0
        t0 = time.monotonic()
        for p in self.players:
            p.finish_refine()
        debug(f"icons: transparency measured in {(time.monotonic() - t0) * 1000:.0f} ms")
        if any(p.pending for p in self.players):
            self.request_refine()
        self.schedule_masks()

    def _refine_abort(self):
        """xfdesktop no ha repintado a tiempo: se deja el fondo en negro y se
        reintenta más tarde (unas pocas veces)."""
        log("icons: xfdesktop did not repaint in time; keeping the provisional transparency")
        self.phase = None
        for p in self.players:
            p.wshots = {}
        self.backdrop.set_key(KEY_BLACK)
        self.refine_fails += 1
        if self.refine_fails <= REFINE_RETRIES:
            self.timeout(1000, self.request_refine)
        self.schedule_masks()

    def players_changed(self):
        """Algo ha cambiado en los reproductores: se actualizan el fondo de
        xfdesktop, el estado publicado y la pausa."""
        self.publish()
        self._sync_backdrop_soon(0)
        self._sync_redirects()
        self.queue_update()

    def publish(self):
        """Estado y sockets de mpv, para la ventana de MintMotion."""
        socks = "\n".join(p.socket for p in self.players if p.mpv is not None and p.socket)
        if socks != self.last_sockets:
            self.last_sockets = socks
            write_atomic(SOCKET_POINTER, socks)
        states = [p.state() for p in self.players]
        for s in ("reproduciendo", "pausado", "dormido", "arrancando", "error"):
            if s in states:
                self.write_state(s)
                return
        self.write_state("arrancando" if self.argv is None and not self.stopping else None)

    def write_state(self, state):
        if state == self.last_state:
            return
        self.last_state = state
        if state:
            write_atomic(STATE_FILE, state)
        else:
            unlink(STATE_FILE)

    # ---------- fondo de xfdesktop ----------

    def _sync_backdrop_soon(self, ms=400):
        if not self.backdrop_id and not self.stopping:
            self.backdrop_id = self.timeout(ms, self._sync_backdrop)

    def _sync_backdrop(self):
        self.backdrop_id = 0
        if self.stopping:
            return
        names = [p.mon.name for p in self.players if p.shown and not p.failed]
        n = self.prop(self.root, "_NET_NUMBER_OF_DESKTOPS")
        had = bool(self.backdrop.backup)
        self.backdrop.sync(names, n[0] if n else 1)
        if names and not had:
            self.keyed_at = time.monotonic()
            self.timeout(5000, self._check_keyed)
        if self.alpha:
            # Si el fondo del usuario ya era negro liso, xfdesktop no repinta
            # y no avisa: se mira el escritorio de todos modos.
            self._all_dirty()

    def _check_keyed(self):
        """Si a los 5 s el fondo sigue sin ser la llave en algún monitor, es
        que xfdesktop lo guarda con otro nombre: se aplica a todos."""
        if self.stopping or self.backdrop.broad or not self.can_mask:
            return
        if self.alpha and (self.phase or self.keyed()):
            return
        for p in self.players:
            if p.shown and (p.mask == "full" or p.ov is not None) and \
                    any(dw.overlaps(p.mon) for dw in self.desks.values()):
                log("the desktop background did not change; applying the key colour to every monitor known to xfconf")
                self.backdrop.broad = True
                self._sync_backdrop_soon(0)
                return

    def _xfconf_changed(self, channel, prop, value):
        if channel == "xfwm4":
            if prop == "/general/inactive_opacity":
                self._read_wm_settings()
                self.queue_update()
            return
        if channel != Backdrop.CHANNEL or self.stopping or not self.backdrop.manages(prop):
            return
        if Backdrop.is_key(prop.rsplit("/", 1)[1], value):
            return
        # El usuario ha tocado su fondo con el vídeo puesto: se recuerda lo
        # que ha elegido y se vuelve a poner la llave (con un límite, por si
        # otro programa insiste).
        self.backdrop.user_changed(prop, value)
        now = time.monotonic()
        self.reasserts = [t for t in self.reasserts if now - t < 60]
        if len(self.reasserts) < 6:
            self.reasserts.append(now)
            self._sync_backdrop_soon(600)

    def _read_wm_settings(self):
        # xfwm4 puede hacer translúcidas las ventanas inactivas (Ajustes del
        # gestor de ventanas → Compositor): entonces no tapan el escritorio.
        v = self.xfconf.get("xfwm4", "/general/inactive_opacity")
        try:
            self.inactive_translucent = v is not None and int(v.unpack()) < 100
        except (TypeError, ValueError):
            self.inactive_translucent = False

    # ---------- D-Bus: xfconf, salvapantallas, sesión ----------

    def _watch_dbus(self):
        bus = self.xfconf.bus
        if bus is None:
            return

        def xfconf_signal(conn, sender, path, iface, name, params):
            channel, prop, value = params.get_child_value(0).get_string(), \
                params.get_child_value(1).get_string(), params.get_child_value(2).get_variant()
            self.guard(self._xfconf_changed, channel, prop, value)

        bus.signal_subscribe(Xfconf.NAME, Xfconf.NAME, "PropertyChanged", Xfconf.PATH, None,
                             Gio.DBusSignalFlags.NONE, xfconf_signal)

        def saver_signal(conn, sender, path, iface, name, params):
            # org.xfce.ScreenSaver, org.cinnamon.ScreenSaver, org.freedesktop.ScreenSaver…
            if not iface.endswith(".ScreenSaver") or params.n_children() < 1:
                return
            v = params.get_child_value(0)
            if v.get_type_string() == "b":
                self.screensaver = v.get_boolean()
                self.guard(self.queue_update)

        bus.signal_subscribe(None, None, "ActiveChanged", None, None,
                             Gio.DBusSignalFlags.NONE, saver_signal)

        # Sesión inactiva (cambio de usuario, otra consola, bloqueo con
        # light-locker): logind lo indica en la propiedad «Active».
        try:
            sysbus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            L = "org.freedesktop.login1"
            spath = sysbus.call_sync(L, "/org/freedesktop/login1", L + ".Manager", "GetSessionByPID",
                                     GLib.Variant("(u)", (os.getpid(),)), GLib.VariantType("(o)"),
                                     Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]

            def get(name):
                return sysbus.call_sync(L, spath, "org.freedesktop.DBus.Properties", "Get",
                                        GLib.Variant("(ss)", (L + ".Session", name)),
                                        GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]

            if get("Type") == "x11" and get("Seat")[0]:
                self.session_inactive = not get("Active")

                def session_signal(conn, sender, path, iface, name, params):
                    changed = params.get_child_value(1).unpack()
                    if "Active" in changed:
                        self.session_inactive = not changed["Active"]
                        self.guard(self.queue_update)

                sysbus.signal_subscribe(L, "org.freedesktop.DBus.Properties", "PropertiesChanged", spath,
                                        None, Gio.DBusSignalFlags.NONE, session_signal)
                self.sysbus = sysbus
        except Exception:
            pass   # sin logind, o sesión sin asiento (remota): no se usa

    # ---------- configuración ----------

    @staticmethod
    def _config_stamp():
        try:
            return os.stat(CONFIG_FILE).st_mtime_ns
        except OSError:
            return 0

    def _config_dir_changed(self, mon, file, other, event):
        names = {f.get_basename() for f in (file, other) if f is not None}
        if names & {"config.json", "xfce-enabled"} and not self.config_id:
            self.config_id = self.timeout(300, self._config_reload)

    def _config_reload(self):
        self.config_id = 0
        if self.stopping:
            return
        if not os.path.exists(ENABLED_FILE):
            log("video background turned off")
            self.shutdown()
            return
        old, self.config = self.config, read_config()
        self.config_stamp = self._config_stamp()
        c = self.config
        if any(c.get(k) != old.get(k) for k in ("video", "fit", "quality")):
            self._prepare()
        elif any(c.get(k) != old.get(k) for k in ("hwdec", "gpu_env")):
            for p in self.players:
                p.reset_decoder()
                p.relaunch()
        else:
            for p in self.players:
                if p.paused:
                    p.cancel_sleep()
                p.paused = None
            self.queue_update()

    # ---------- eventos X ----------

    def _event(self, ev):
        t = ev.type
        if t == X.PropertyNotify:
            if ev.window.id == self.root.id:
                self._root_property(ev.atom)
            elif ev.atom in self.relevant:
                info = self.clients.get(ev.window.id)
                if info is not None:
                    info.dirty = True
                    if ev.atom == self.a["_NET_WM_WINDOW_TYPE"]:
                        self._sync_desks()
                    self.queue_update()
        elif t == X.ConfigureNotify:
            wid = ev.window.id
            if wid == self.root.id:
                self._monitors_changed_soon()
                return
            if wid in self.or_windows:
                self.or_windows[wid] = (ev.x, ev.y, ev.width, ev.height, self.or_windows[wid][4])
            if wid in self.desks:
                self._locate(self.desks[wid])
                self._all_dirty()
            self.queue_update()
        elif t == X.MapNotify:
            wid = ev.window.id
            if ev.event.id == self.root.id and ev.override and wid not in self.own:
                self._track_unmanaged(ev.window)
            self.queue_update()
        elif t == X.UnmapNotify:
            self.or_windows.pop(ev.window.id, None)
            self.queue_update()
        elif t == X.DestroyNotify:
            wid = ev.window.id
            self.or_windows.pop(wid, None)
            self.frames.pop(wid, None)
            self.redirected.pop(wid, None)
            if self.clients.pop(wid, None) is not None:
                self._sync_desks()
            self.queue_update()
        elif t == X.ReparentNotify:
            wid = ev.window.id
            self.frames.pop(wid, None)
            p = self.own.get(wid)
            if p is not None and ev.parent.id != self.root.id:
                p.settle()
                self._sync_redirects()
            self.queue_update()
        elif self.damage_event is not None and t == self.damage_event:
            dw = self.desks.get(ev.drawable.id)
            if dw is not None and dw.rect is not None:
                y = dw.rect[1] + ev.area.y
                for p in self.players:
                    if p.shown:
                        p.mark_dirty(y - p.mon.y, y + ev.area.height - p.mon.y)
        elif t == X.Expose:
            p = self.own.get(ev.window.id)
            if p is not None and p.ov is not None and ev.window.id == p.ov.id:
                p.paint(ev.y, ev.height)
        elif self.randr_event is not None and t == self.randr_event:
            self._monitors_changed_soon()

    def _root_property(self, atom):
        a = self.a
        if atom == a["_NET_CLIENT_LIST"]:
            self._sync_clients()
        elif atom == a["_NET_NUMBER_OF_DESKTOPS"]:
            self._sync_backdrop_soon()
        elif atom == a["_NET_SUPPORTING_WM_CHECK"]:
            self.frames.clear()
            self._sync_clients()
        elif atom not in (a["_NET_CLIENT_LIST_STACKING"], a["_NET_CURRENT_DESKTOP"],
                          a["_NET_ACTIVE_WINDOW"], a["_NET_SHOWING_DESKTOP"]):
            return
        self.queue_update()

    def _track_unmanaged(self, win):
        try:
            g = win.get_geometry()
        except xerror.XError:
            return
        self.or_windows[win.id] = (g.x, g.y, g.width + 2 * g.border_width,
                                   g.height + 2 * g.border_width, g.depth)

    def _scan_unmanaged(self):
        try:
            children = self.root.query_tree().children
        except xerror.XError:
            return
        for w in children:
            try:
                at = w.get_attributes()
            except xerror.XError:
                continue
            if at.override_redirect and at.map_state == X.IsViewable and at.win_class == X.InputOutput:
                self._track_unmanaged(w)

    def _sync_clients(self):
        ids = self.prop(self.root, "_NET_CLIENT_LIST") or []
        cur = set(ids)
        for wid in cur - set(self.clients):
            win = self.d.create_resource_object("window", wid)
            if wid not in self.own:
                win.change_attributes(event_mask=X.PropertyChangeMask | X.StructureNotifyMask)
            self.clients[wid] = WinInfo(win)
        for wid in set(self.clients) - cur:
            del self.clients[wid]
            self.frames.pop(wid, None)
        self._sync_desks()

    def info(self, wid):
        info = self.clients.get(wid)
        if info is None:
            return None
        if info.dirty:
            self._load(info)
        return info

    def _load(self, info):
        a = self.a
        w = info.win
        info.dirty = False
        types = self.prop(w, "_NET_WM_WINDOW_TYPE") or []
        known = self.covering_types | {a["_NET_WM_WINDOW_TYPE_DESKTOP"], a["_NET_WM_WINDOW_TYPE_DOCK"]}
        info.type = next((t for t in types if t in known), None)
        if info.type is None and not types:
            try:
                transient = w.get_full_property(Xatom.WM_TRANSIENT_FOR, X.AnyPropertyType)
            except xerror.XError:
                transient = None
            info.type = a["_NET_WM_WINDOW_TYPE_DIALOG"] if transient else a["_NET_WM_WINDOW_TYPE_NORMAL"]
        info.state = frozenset(self.prop(w, "_NET_WM_STATE") or [])
        v = self.prop(w, "_NET_WM_DESKTOP")
        info.desktop = v[0] if v else None
        v = self.prop(w, "_NET_WM_WINDOW_OPACITY")
        info.opacity = v[0] if v else 0xFFFFFFFF
        s = self.prop(w, "_NET_WM_STRUT_PARTIAL")
        if not s or len(s) < 12:
            s4 = self.prop(w, "_NET_WM_STRUT")
            s = (list(s4[:4]) + [0, 1 << 30] * 4) if s4 and len(s4) >= 4 else None
        info.strut = s if s and any(s[:4]) else None
        v = self.prop(w, "_GTK_FRAME_EXTENTS")
        info.gtk = v[:4] if v and len(v) >= 4 else None

    # ---------- ventanas de escritorio (xfdesktop) y máscara ----------

    def _sync_desks(self):
        desk_type = self.a["_NET_WM_WINDOW_TYPE_DESKTOP"]
        cur = set()
        for wid in list(self.clients):
            if wid in self.own:
                continue
            info = self.info(wid)
            if info is not None and info.type == desk_type:
                cur.add(wid)
        if cur == set(self.desks):
            return
        for wid in set(self.desks) - cur:
            dw = self.desks.pop(wid)
            if dw.damage is not None:
                try:
                    self.d.damage_destroy(dw.damage)
                except Exception:
                    pass
        xfdesk = set(self.prop(self.root, "XFCE_DESKTOP_WINDOW") or [])
        for wid in cur - set(self.desks):
            dw = DesktopWindow(self.clients[wid].win)
            try:
                cls = dw.win.get_wm_class() or ()
                dw.depth = dw.win.get_geometry().depth
            except xerror.XError:
                cls = ()
            dw.keyed = wid in xfdesk or any("xfdesktop" in (c or "").lower() for c in cls)
            if self.have_damage:
                from Xlib.ext import damage
                try:
                    dw.damage = dw.win.damage_create(damage.DamageReportRawRectangles)
                except Exception:
                    dw.damage = None
            self._locate(dw)
            self.desks[wid] = dw
        debug(f"desktop windows: {[hex(w) for w in self.desks]} damage={self.have_damage}")
        self._sync_redirects()
        self._all_dirty()

    def _locate(self, dw):
        try:
            g = dw.win.get_geometry()
            o = self.root.translate_coords(dw.win, 0, 0)
            dw.rect = (o.x, o.y, g.width, g.height)
        except xerror.XError:
            dw.rect = None

    def _all_dirty(self):
        for p in self.players:
            if p.shown:
                p.mark_dirty(0, p.mon.h)

    def schedule_masks(self, ms=30):
        if not self.mask_id:
            self.mask_id = self.timeout(ms, self._run_masks)

    def _run_masks(self):
        self.mask_id = 0
        for dw in self.desks.values():
            if dw.rect is None:
                self._locate(dw)
        for p in self.players:
            p.update_mask()
        if self.trim_id:
            self.cancel(self.trim_id)
        self.trim_id = self.timeout(3000, self._trim)

    def _trim(self):
        self.trim_id = 0
        self.matcher._consts.clear()
        self.lanes.clear()
        if DEBUG:
            before = process_pss_kb(os.getpid())
        release_memory()
        if DEBUG:
            debug(f"memory: {before} -> {process_pss_kb(os.getpid())} KB (PSS)")

    def _sync_redirects(self):
        """Sin compositor, el servidor X no guarda lo que queda tapado. Se le
        pide que guarde (redirección automática) el contenido de xfdesktop,
        para poder leer los iconos que tapa el vídeo, y el de las ventanas del
        vídeo, para que conserven el último fotograma. Con compositor ya lo
        hace él y no se toca nada."""
        if not self.have_composite or not self.x_ok:
            return
        from Xlib.ext import composite
        want = {}
        if self.d.get_selection_owner(self.a_cm) == X.NONE and not self.stopping:
            for win in [dw.win for dw in self.desks.values()] + \
                       [p.win for p in self.players if p.win is not None and p.shown and p.ov is None]:
                top = self.toplevel(win)
                if top is not None and top.id != self.root.id:
                    want[top.id] = top
        for wid, top in want.items():
            if wid not in self.redirected:
                top.composite_redirect_window(composite.RedirectAutomatic)
                self.redirected[wid] = top
                self._all_dirty()
        for wid in [w for w in self.redirected if w not in want]:
            self.redirected.pop(wid).composite_unredirect_window(composite.RedirectAutomatic)

    # ---------- pausa automática ----------

    def queue_update(self):
        if not self.update_id and not self.stopping:
            self.update_id = self.timeout(150, self._update_playback)

    def _poll(self):
        """Red de seguridad: revisión periódica muy barata."""
        if self.stopping:
            return
        # por si el aviso de cambios en la carpeta no llega (límite de inotify…)
        if not os.path.exists(ENABLED_FILE) or self._config_stamp() != self.config_stamp:
            if not self.config_id:
                self.config_id = self.timeout(300, self._config_reload)
        if self.have_dpms:
            try:
                i = self.d.dpms_info()
                self.display_off = bool(i.state) and i.power_level != 0
            except Exception:
                self.display_off = False
        self._check_mode()
        self._check_stacking()
        if self.alpha and not self.phase and \
                any(p.shown and p.ov is not None and not p.asigs for p in self.players):
            self._all_dirty()   # capa de iconos aún sin contenido: se reintenta
        self._sync_redirects()
        if not self.have_damage:
            self._all_dirty()
        self.polls += 1
        if self.polls % 5 == 0:
            mons = self._read_monitors()
            if [(m.name, m.rect) for m in mons] != [(m.name, m.rect) for m in self.monitors]:
                self._monitors_changed_soon()
        self._update_playback()

    def _update_playback(self):
        if self.update_id:
            self.cancel(self.update_id)
            self.update_id = 0
        if self.stopping or not self.players:
            return
        forced = self.screensaver or self.session_inactive or self.display_off
        covered = None
        if not forced and self.config.get("pause_when_covered"):
            covered = self._covered()
        for i, p in enumerate(self.players):
            p.set_pause(bool(forced or (covered is not None and covered[i])))
        self.publish()

    def _work_areas(self):
        """Área de cada monitor que no ocupan los paneles (lo que el
        escritorio tiene que tener tapado para considerarlo tapado)."""
        W, H = self.root_size
        mons = [p.mon for p in self.players]
        areas = [[m.x, m.y, m.x + m.w, m.y + m.h] for m in mons]
        hidden = self.a["_NET_WM_STATE_HIDDEN"]
        for wid in list(self.clients):
            info = self.info(wid)
            if info is None or not info.strut or hidden in info.state:
                continue
            left, right, top, bottom, ly0, ly1, ry0, ry1, tx0, tx1, bx0, bx1 = info.strut[:12]
            for m, ar in zip(mons, areas):
                mx1, my1 = m.x + m.w, m.y + m.h
                # una reserva solo cuenta en el monitor donde termina
                if top and m.y < top <= my1 and tx0 < mx1 and tx1 >= m.x:
                    ar[1] = max(ar[1], top)
                if bottom and m.y <= H - bottom < my1 and bx0 < mx1 and bx1 >= m.x:
                    ar[3] = min(ar[3], H - bottom)
                if left and m.x < left <= mx1 and ly0 < my1 and ly1 >= m.y:
                    ar[0] = max(ar[0], left)
                if right and m.x <= W - right < mx1 and ry0 < my1 and ry1 >= m.y:
                    ar[2] = min(ar[2], W - right)
        return [(x0, y0, x1 - x0, y1 - y0) for x0, y0, x1, y1 in areas]

    def _covered(self):
        """Para cada monitor, True si su escritorio queda tapado por completo
        (por una ventana o por la suma de varias)."""
        a = self.a
        uncovered = [[r] if r[2] > 0 and r[3] > 0 else [] for r in self._work_areas()]
        # Ventanas sin gestionar que cubren un monitor entero: salvapantallas,
        # bloqueo de pantalla, juegos a pantalla completa. Las de 32 bits son
        # capas transparentes (anotaciones, capturas) y no cuentan.
        for x, y, w, h, depth in self.or_windows.values():
            if depth == 32:
                continue
            for i, p in enumerate(self.players):
                m = p.mon
                if x <= m.x and y <= m.y and x + w >= m.x + m.w and y + h >= m.y + m.h:
                    uncovered[i] = []
        if not any(uncovered):
            return [True] * len(uncovered)
        cur = self.prop(self.root, "_NET_CURRENT_DESKTOP")
        cur = cur[0] if cur else None
        active = None
        if self.inactive_translucent:
            v = self.prop(self.root, "_NET_ACTIVE_WINDOW")
            active = v[0] if v else 0
        hidden, shaded, fullscreen = a["_NET_WM_STATE_HIDDEN"], a["_NET_WM_STATE_SHADED"], \
            a["_NET_WM_STATE_FULLSCREEN"]
        stacking = self.prop(self.root, "_NET_CLIENT_LIST_STACKING") or []
        for wid in reversed(stacking):
            if wid in self.own:
                continue
            info = self.info(wid)
            if info is None or info.type not in self.covering_types:
                continue
            if hidden in info.state or shaded in info.state:
                continue
            if cur is not None and info.desktop is not None and info.desktop not in (cur, 0xFFFFFFFF):
                continue
            if info.opacity < 0xFFFFFFFF:
                continue   # ventana translúcida: deja ver el fondo
            # Las ventanas con canal alfa (32 bits) cuentan como las demás:
            # casi todas son opacas (el terminal de Xfce lo es siempre) y no
            # hay forma fiable de saber cuáles dejan ver el fondo.
            full = fullscreen in info.state
            if active is not None and wid != active and not full:
                continue   # xfwm4 hace translúcidas las ventanas inactivas
            rect = self._frame_rect(info)
            if rect is None:
                continue
            for i in range(len(uncovered)):
                if uncovered[i]:
                    uncovered[i] = subtract_rect(uncovered[i], rect)
            if not any(uncovered):
                break
        return [not u for u in uncovered]

    def _frame_rect(self, info):
        top = self.toplevel(info.win)
        if top is None:
            return None
        try:
            if top.get_attributes().map_state != X.IsViewable:
                return None
            g = top.get_geometry()
            x, y, w, h = g.x, g.y, g.width + 2 * g.border_width, g.height + 2 * g.border_width
        except xerror.XError:
            self.frames.pop(info.win.id, None)
            return None
        if info.gtk:   # decoración propia (CSD): el marco incluye la sombra
            left, right, t, b = info.gtk
            x, y, w, h = x + left, y + t, w - left - right, h - t - b
        return (x, y, w, h) if w > 0 and h > 0 else None

    # ---------- cierre ----------

    def _on_signal(self):
        if self.stopping:
            self.quit()
        else:
            self.guard(self.shutdown)
        return True

    def shutdown(self):
        """Cierre ordenado: el vídeo tapa los iconos, se devuelve el fondo
        del usuario y, cuando xfdesktop ya lo ha pintado, se quita el vídeo."""
        if self.stopping:
            return
        self.stopping = True
        self.hiding = True
        self.phase = None
        for tid in list(self.timeouts):
            self.cancel(tid)
        shown = [p for p in self.players if p.shown and p.win is not None]
        had_key = bool(self.backdrop.backup) and self.backdrop.restore_changes(self._shown_workspace())
        self.probe_snapshot = self._probe_rows() if self.alpha else None
        for p in shown:
            p._set_full()
        self.d.flush()
        self.backdrop.restore_all()
        if shown and had_key and self.desks and self.can_mask:
            self._wait_backdrop(time.monotonic())
        else:
            self._finish()

    def _shown_workspace(self):
        """Espacio de trabajo cuyo fondo pinta xfdesktop: uno fijo para todos
        (lo normal) o el actual. None si no se puede saber."""
        try:
            v = self.xfconf.get(Backdrop.CHANNEL, "/backdrop/single-workspace-mode")
            if v is None or v.unpack():
                n = self.xfconf.get(Backdrop.CHANNEL, "/backdrop/single-workspace-number")
                return int(n.unpack()) if n is not None else 0
            cur = self.prop(self.root, "_NET_CURRENT_DESKTOP")
            return cur[0] if cur else None
        except Exception:
            return None

    def _wait_backdrop(self, t0):
        """Espera (3 s como mucho) a que xfdesktop deje de mostrar la llave."""
        waited = time.monotonic() - t0
        if waited < 3.0 and (waited < 0.3 or self._still_keyed()):
            GLib.timeout_add(100, lambda: self.guard(self._wait_backdrop, t0) and False)
            return
        self._finish()

    def _still_keyed(self):
        if self.alpha:
            # con la capa de iconos: hasta que xfdesktop pinte otra cosa
            return bool(self.probe_snapshot) and self._probe_rows() == self.probe_snapshot
        for dw in self.desks.values():
            try:
                g = dw.win.get_geometry()
                y = g.height // 2
                raw = dw.win.get_image(0, y, g.width, 1, X.ZPixmap, 0xffffffff).data
            except xerror.XError:
                continue
            if len(raw) == g.width * 4 and \
                    self.matcher.bits(raw, g.width).count(b"1") > MIN_VISIBLE * g.width:
                return True
        return False

    def _finish(self):
        pending = [len(self.players)]

        def one_done():
            pending[0] -= 1
            if pending[0] <= 0:
                self.quit()

        if not self.players:
            self.quit()
            return
        for p in self.players:
            proc = p.mpv
            p.destroy()
            if proc is None:
                one_done()
            else:
                proc.wait_async(None, lambda pr, res: one_done())
        self.players = []
        self._sync_redirects()
        self.d.flush()
        GLib.timeout_add(4000, lambda: self.quit() and False)

    def _x_lost(self):
        """El servidor X se ha ido (cierre de sesión): ya no hay ventanas que
        quitar; se devuelve el fondo del usuario para la próxima sesión."""
        if not self.x_ok:
            return
        self.x_ok = False
        self.stopping = True
        for p in self.players:
            if p.mpv is not None:
                try:
                    p.mpv.force_exit()
                except GLib.Error:
                    pass
        try:
            self.backdrop.restore_all()
        except Exception:
            pass
        self.quit()

    def quit(self):
        unlink(SOCKET_POINTER)
        unlink(STATE_FILE)
        for p in self.players:
            if p.socket:
                unlink(p.socket)
        pid = read_text(PID_FILE)
        if pid and pid.strip() == str(os.getpid()):
            unlink(PID_FILE)
        if self.loop.is_running():
            self.loop.quit()
        else:
            raise SystemExit(0)


def main():
    if "--restore" in sys.argv[1:]:
        # Devuelve el fondo de xfdesktop si un cierre brusco lo dejó en el color llave
        Backdrop(Xfconf()).restore_all()
        return 0
    if sys.argv[1:] and sys.argv[1] not in ("--autostart",):
        print("usage: mintmotion-xfce [--autostart | --restore]", file=sys.stderr)
        return 2
    if not os.path.exists(ENABLED_FILE):
        return 0   # el vídeo no está activado: nada que hacer
    if os.environ.get("XDG_SESSION_TYPE") == "wayland" or not os.environ.get("DISPLAY"):
        return 0
    open_log()
    try:
        daemon = Daemon()
    except xerror.DisplayError as e:
        log(f"cannot open the X display: {e}")
        return 1
    daemon.loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
