_console = None   # salida de error original (el descriptor 2 pasa a ser el registro)


def log(msg):
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    try:
        print(f"{stamp} {msg}", file=sys.stderr, flush=True)
    except (OSError, ValueError):
        pass
    if _console is not None:
        try:
            os.write(_console, f"[mintmotion] {msg}\n".encode("utf-8", "replace"))
        except OSError:
            pass


DEBUG = bool(os.environ.get("MINTMOTION_DEBUG"))


def debug(msg):
    if DEBUG:
        log("debug: " + msg)


def open_log():
    """El registro va a ~/.cache/mintmotion/mintmotion.log (también lo que
    escriba mpv) y, además, a la salida de error de quien nos lanzó."""
    global _console
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        if os.path.exists(LOG_FILE) and os.path.getsize(LOG_FILE) > 256 * 1024:
            with open(LOG_FILE, "rb") as f:
                f.seek(-64 * 1024, os.SEEK_END)
                tail = f.read()
            with open(LOG_FILE, "wb") as f:
                f.write(tail[tail.find(b"\n") + 1:])
        fd = os.open(LOG_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    except OSError:
        return
    try:
        _console = os.dup(2)
    except OSError:
        _console = None
    os.dup2(fd, 1)
    os.dup2(fd, 2)
    os.close(fd)


def read_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict):
            cfg.update(data)
    except (OSError, ValueError):
        pass  # sin configuración todavía, o JSON a medio escribir
    return cfg


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def unlink(path):
    try:
        os.unlink(path)
    except OSError:
        pass


def write_atomic(path, text):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except OSError:
        pass


def process_pss_kb(pid):
    """PSS (memoria real, en KB) de un proceso; 0 si no se puede leer."""
    m = re.search(r"^Pss:\s+(\d+)", read_text(f"/proc/{pid}/smaps_rollup") or "", re.M)
    return int(m.group(1)) if m else 0


_setpriv = False


def setpriv_path():
    """¿setpriv admite --pdeathsig? (util-linux ≥ 2.33). Con él, mpv muere si
    muere este proceso y nunca quedan reproductores huérfanos."""
    global _setpriv
    if _setpriv is False:
        _setpriv = None
        path = GLib.find_program_in_path("setpriv")
        if path:
            try:
                p = Gio.Subprocess.new([path, "--pdeathsig", "KILL", "true"],
                                       Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
                if p.wait(None) and p.get_successful():
                    _setpriv = path
            except GLib.Error:
                pass
    return _setpriv


def nvidia_only_env():
    """Variables de entorno para mpv solo en equipos con una única GPU y que
    sea NVIDIA (driver propietario): mpv no carga además los drivers de Mesa.
    En equipos híbridos, Intel o AMD no se toca nada."""
    if not os.path.exists("/proc/driver/nvidia/version"):
        return []
    vendors = set()
    try:
        for name in os.listdir("/sys/class/drm"):
            if re.fullmatch(r"card\d+", name):
                v = read_text(f"/sys/class/drm/{name}/device/vendor")
                if v:
                    vendors.add(v.strip().lower())
    except OSError:
        return []
    if vendors != {"0x10de"}:
        return []
    env = []
    icd = next((f for f in ("/usr/share/vulkan/icd.d/nvidia_icd.json", "/etc/vulkan/icd.d/nvidia_icd.json")
                if os.path.exists(f)), None)
    if icd:
        env += [("VK_DRIVER_FILES", icd), ("VK_ICD_FILENAMES", icd)]
    egl = next((f for f in ("/usr/share/glvnd/egl_vendor.d/10_nvidia.json", "/etc/glvnd/egl_vendor.d/10_nvidia.json")
                if os.path.exists(f)), None)
    if egl:
        env.append(("__EGL_VENDOR_LIBRARY_FILENAMES", egl))
    return env


_libc = False


def release_memory():
    """Devuelve al sistema la memoria que queda libre tras calcular una
    máscara (varios MB de datos temporales que glibc, si no, se guarda)."""
    global _libc
    if _libc is False:
        try:
            import ctypes
            _libc = ctypes.CDLL(None)
            _libc.malloc_trim.argtypes = [ctypes.c_size_t]
        except (ImportError, OSError, AttributeError):
            _libc = None
    if _libc is not None:
        try:
            _libc.malloc_trim(0)
        except Exception:
            pass


def subtract_rect(rects, b):
    """Resta el rectángulo b = (x, y, w, h) a cada rectángulo de la lista."""
    out = []
    bx, by, bw, bh = b
    bx2, by2 = bx + bw, by + bh
    for a in rects:
        ax, ay, aw, ah = a
        ax2, ay2 = ax + aw, ay + ah
        if bx >= ax2 or bx2 <= ax or by >= ay2 or by2 <= ay:
            out.append(a)           # no se tocan
            continue
        if by > ay:
            out.append((ax, ay, aw, by - ay))            # arriba
        if by2 < ay2:
            out.append((ax, by2, aw, ay2 - by2))         # abajo
        top, bottom = max(ay, by), min(ay2, by2)
        if bx > ax:
            out.append((ax, top, bx - ax, bottom - top))     # izquierda
        if bx2 < ax2:
            out.append((bx2, top, ax2 - bx2, bottom - top))  # derecha
    return out


