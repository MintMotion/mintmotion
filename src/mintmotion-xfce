# ---------------------------------------------------------------------------

class Xfconf:
    NAME = "org.xfce.Xfconf"
    PATH = "/org/xfce/Xfconf"

    def __init__(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error:
            self.bus = None

    def _call(self, method, params, reply=None):
        return self.bus.call_sync(self.NAME, self.PATH, self.NAME, method, params,
                                  GLib.VariantType(reply) if reply else None,
                                  Gio.DBusCallFlags.NONE, 3000, None)

    def get_all(self, channel, base):
        """{propiedad: GLib.Variant}. None si xfconf no está disponible."""
        if not self.bus:
            return None
        try:
            entries = self._call("GetAllProperties", GLib.Variant("(ss)", (channel, base)),
                                 "(a{sv})").get_child_value(0)
        except GLib.Error as e:
            # canal o propiedad sin crear todavía: xfconf está, pero vacío
            remote = Gio.DBusError.get_remote_error(e) or ""
            return {} if remote.startswith("org.xfce.Xfconf.Error.") else None
        out = {}
        for i in range(entries.n_children()):
            entry = entries.get_child_value(i)
            out[entry.get_child_value(0).get_string()] = entry.get_child_value(1).get_variant()
        return out

    def get(self, channel, prop):
        if not self.bus:
            return None
        try:
            return self._call("GetProperty", GLib.Variant("(ss)", (channel, prop)), "(v)") \
                       .get_child_value(0).get_variant()
        except GLib.Error:
            return None

    def set(self, channel, prop, value):
        try:
            self._call("SetProperty", GLib.Variant("(ssv)", (channel, prop, value)))
            return True
        except GLib.Error as e:
            log(f"xfconf: could not set {prop}: {e.message}")
            return False

    def reset(self, channel, prop):
        try:
            self._call("ResetProperty", GLib.Variant("(ssb)", (channel, prop, False)))
        except GLib.Error:
            pass


class Backdrop:
    """Fondo de xfdesktop. Mientras un monitor tiene vídeo, su fondo es el
    color llave; los valores del usuario se guardan en xfce-backdrop.json y se
    devuelven al terminar. El archivo sobrevive a un cierre brusco: si existe
    al arrancar, lo guardado ahí sigue siendo lo que hay que restaurar."""

    CHANNEL = "xfce4-desktop"
    PROPS = ("color-style", "image-style", "rgba1")
    PREFIX_RE = re.compile(r"^(/backdrop/screen\d+/monitor([^/]+)/workspace\d+)/([^/]+)$")
    # valores por defecto de xfdesktop 4.18 (azul oscuro liso, imagen ampliada)
    DEFAULTS = {"color-style": GLib.Variant("i", 0), "image-style": GLib.Variant("i", 5),
                "rgba1": GLib.Variant("av", [GLib.Variant("d", v) for v in (0.08235, 0.13333, 0.2, 1.0)])}

    def __init__(self, xfconf, screen_num=0):
        self.xfconf = xfconf
        self.screen_num = screen_num
        self.broad = False     # aplicar a todos los monitores que conozca xfconf
        self.key = KEY_RGB     # color llave que se quiere ahora en xfdesktop
        self.backup = {}       # propiedad -> texto del valor original (None = no existía)
        try:
            with open(BACKDROP_FILE, encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                self.backup = data
        except (OSError, ValueError):
            pass

    def key_value(self, prop):
        if prop == "rgba1":
            return GLib.Variant("av", [GLib.Variant("d", c / 255.0) for c in self.key] +
                                [GLib.Variant("d", 1.0)])
        return GLib.Variant("i", 0)   # color liso / sin imagen

    @staticmethod
    def is_key(prop, value, keys=ALL_KEYS):
        """¿Es uno de los valores que pone MintMotion (cualquiera de sus colores llave)?"""
        if value is None:
            return False
        try:
            v = value.unpack()
        except Exception:
            return False
        if prop == "rgba1":
            return (isinstance(v, (list, tuple)) and len(v) == 4 and
                    all(isinstance(c, (int, float)) for c in v) and v[3] > 0.999 and
                    any(all(abs(v[i] - k[i] / 255.0) < 1e-4 for i in range(3)) for k in keys))
        return v == 0 and not isinstance(v, bool)

    def set_key(self, rgb):
        """Cambia el color llave en los fondos que ya están intervenidos."""
        if rgb == self.key:
            return
        self.key = rgb
        if self.xfconf.bus is None:
            return
        for path in self.backup:
            if path.endswith("/rgba1"):
                self.xfconf.set(self.CHANNEL, path, self.key_value("rgba1"))

    def manages(self, prop):
        return prop in self.backup

    def _save(self):
        if self.backup:
            write_atomic(BACKDROP_FILE, json.dumps(self.backup, indent=1))
        else:
            unlink(BACKDROP_FILE)

    def sync(self, names, nworkspaces):
        """Pone la llave en los monitores «names» (nombres de salida, como los
        usa xfdesktop) y devuelve su fondo a los demás."""
        if self.xfconf.bus is None:
            return False
        if not names and not self.backup:
            return True
        props = self.xfconf.get_all(self.CHANNEL, "/backdrop")
        if props is None:
            return False
        ids = {re.sub(r"\s+", "", n) for n in names if n}
        everything = bool(names) and (self.broad or len(ids) < len(names))
        wanted = set()
        for n in ids:
            for ws in range(max(nworkspaces, 1)):
                wanted.add(f"/backdrop/screen{self.screen_num}/monitor{n}/workspace{ws}")
        for path in props:
            m = self.PREFIX_RE.match(path)
            if m and (everything or m.group(2) in ids):
                wanted.add(m.group(1))
        changed = False
        for prefix in sorted(wanted):
            for prop in self.PROPS:
                path = f"{prefix}/{prop}"
                cur = props.get(path)
                if self.is_key(prop, cur, (self.key,)):
                    if prop == "rgba1" and path not in self.backup and self.key != KEY_RGB:
                        # negro o blanco puro pueden ser el color del usuario
                        self.backup[path] = cur.print_(True)
                        changed = True
                    continue
                if path not in self.backup and not self.is_key(prop, cur, (KEY_RGB,)):
                    self.backup[path] = cur.print_(True) if cur is not None else None
                    changed = True
                self.xfconf.set(self.CHANNEL, path, self.key_value(prop))
        for path in [p for p in self.backup if p.rsplit("/", 1)[0] not in wanted]:
            self._restore(path)
            changed = True
        if changed:
            self._save()
        return True

    def _restore(self, path):
        text = self.backup.pop(path, None)
        value = None
        if text is not None:
            try:
                value = GLib.Variant.parse(None, text, None, None)
            except GLib.Error:
                value = None
        if value is not None:
            self.xfconf.set(self.CHANNEL, path, value)
        else:
            # La propiedad no existía. xfdesktop 4.18 no se entera de que se
            # borra una propiedad y seguiría pintando la llave: primero se le
            # da su valor por defecto y después se borra.
            default = self.DEFAULTS.get(path.rsplit("/", 1)[1])
            if default is not None:
                self.xfconf.set(self.CHANNEL, path, default)
            self.xfconf.reset(self.CHANNEL, path)

    def restore_changes(self, workspace=None):
        """¿Se verá algún cambio al devolver el fondo? (No, si el del usuario
        es justo el color liso que hay puesto ahora.) Con «workspace», solo se
        miran los ajustes de ese espacio de trabajo, que es el que se ve."""
        for path, text in self.backup.items():
            if workspace is not None and not path.rsplit("/", 1)[0].endswith(f"/workspace{workspace}"):
                continue
            if text is None:
                return True
            try:
                value = GLib.Variant.parse(None, text, None, None)
            except GLib.Error:
                return True
            if not self.is_key(path.rsplit("/", 1)[1], value, (self.key,)):
                return True
        return False

    def restore_all(self):
        if not self.backup:
            return
        if self.xfconf.bus is None:
            return
        # primero los colores y al final el estilo de imagen: un solo repintado visible
        for path in sorted(self.backup, key=lambda p: p.endswith("/image-style")):
            self._restore(path)
        self._save()

    def user_changed(self, prop, value):
        """El usuario ha cambiado su fondo con el vídeo puesto: ese es ahora
        el valor que hay que devolver al quitar el vídeo."""
        self.backup[prop] = value.print_(True)
        self._save()


# ---------------------------------------------------------------------------
# Comparación de píxeles con el color llave
# ---------------------------------------------------------------------------

_NONZERO_TO_BIT = bytes.maketrans(b"\x00\x01", b"10")   # igual a la llave -> «1» (se ve el vídeo)
_NONZERO_TO_FF = bytes([0] + [255] * 255)


class KeyMatcher:
    """Convierte una imagen X11 de 32 bits por píxel en una cadena de «1»
    (píxel igual a la llave) y «0». Se hace con enteros muy grandes, que
    Python opera en C: sin bucles por píxel y sin dependencias (numpy…)."""

    def __init__(self, lsb_first):
        r, g, b = KEY_RGB
        if lsb_first:
            self.key, self.mask = bytes((b, g, r, 0)), b"\xff\xff\xff\x00"
        else:
            self.key, self.mask = bytes((0, r, g, b)), b"\x00\xff\xff\xff"
        self._consts = {}

    def bits(self, raw, n):
        c = self._consts.get(n)
        if c is None:
            if len(self._consts) >= 6:
                self._consts.clear()
            c = self._consts[n] = (int.from_bytes(self.key * n, "little"),
                                   int.from_bytes(self.mask * n, "little"),
                                   int.from_bytes(b"\x01\x00\x00\x00" * n, "little"))
        key, mask, ones = c
        x = (int.from_bytes(raw, "little") ^ key) & mask
        x |= (x >> 8) | (x >> 16) | (x >> 24)   # cualquier diferencia, al primer byte del píxel
        x |= x >> 4
        x |= x >> 2
        x |= x >> 1                              # ...y al primer bit
        x &= ones
        return x.to_bytes(n * 4, "little")[0::4].translate(_NONZERO_TO_BIT)


def and_bits(a, b):
    """Y lógico de dos cadenas de «0»/«1» (0x30/0x31) de la misma longitud."""
    return (int.from_bytes(a, "little") & int.from_bytes(b, "little")).to_bytes(len(a), "little")


def pack_bits(bits, width, rows, pad, lsb_first):
    """Cadena de «0»/«1» (una por píxel) -> mapa de bits X11 de 1 bit por
    píxel, con cada fila rellenada hasta un múltiplo de 32 bits."""
    if pad:
        zeros = b"0" * pad
        bits = b"".join([bits[r * width:(r + 1) * width] + zeros for r in range(rows)])
    if lsb_first:
        return int(bits[::-1], 2).to_bytes(len(bits) // 8, "little")
    return int(bits, 2).to_bytes(len(bits) // 8, "big")


# ---------------------------------------------------------------------------
# Capa de iconos: transparencia real a partir de dos capturas
# ---------------------------------------------------------------------------
#
# xfdesktop pinta cada píxel como  color·α + fondo·(1 − α).  Con el fondo negro
# la captura es directamente el color premultiplicado (color·α); con el fondo
# blanco es eso mismo más 255·(1 − α). Por tanto α = 255 − (blanco − negro), y
# una ventana ARGB con (negro, α) encima del vídeo da, al componerla, lo mismo
# que xfdesktop pintaría sobre ese fotograma.
#
# Las cuentas se hacen con enteros muy grandes, un canal cada vez y un valor
# por «carril» de 16 bits, para que sumas y restas no se pisen entre píxeles.

class Lanes:
    def __init__(self):
        self._c = {}

    def consts(self, n):
        c = self._c.get(n)
        if c is None:
            if len(self._c) >= 6:
                self._c.clear()
            c = self._c[n] = (int.from_bytes(b"\x01\x00" * n, "little"),    # 1 en cada carril
                              int.from_bytes(b"\xff\x00" * n, "little"),    # 255
                              int.from_bytes(b"\x00\x01" * n, "little"))    # 256
        return c

    def clear(self):
        self._c.clear()

    @staticmethod
    def load(plane):
        buf = bytearray(2 * len(plane))
        buf[0::2] = plane
        return int.from_bytes(buf, "little")

    @staticmethod
    def store(v, n):
        return v.to_bytes(2 * n, "little")[0::2]


def lane_satsub(a, b, c):
    """max(a − b, 0) en cada carril (valores de 0 a 255)."""
    one, _ff, h = c
    x = (a | h) - b
    return x & (((x >> 8) & one) * 255)


def lane_max(a, b, c):
    return b + lane_satsub(a, b, c)


def lane_nonzero(a, c):
    """255 en los carriles distintos de cero (valores de 0 a 255)."""
    one, ff, _h = c
    return (((a + ff) >> 8) & one) * 255


def alpha_exact(nb, ng, nr, wb, wg, wr, c):
    """α = 255 − (blanco − negro), con el verde contando doble (si el texto
    usa suavizado subpíxel, los tres canales no coinciden)."""
    one, ff, _h = c
    s = lane_satsub(wr, nr, c) + 2 * lane_satsub(wg, ng, c) + lane_satsub(wb, nb, c) + 2 * one
    return ff - ((s >> 2) & ff)


def alpha_provisional(nb, ng, nr, ob, og, o_r, oa, c):
    """Mientras no se mide: los píxeles que no cambian conservan su α; los que
    cambian toman el mayor entre el α que tenían y el mínimo posible para su
    nuevo color (0 si quedan en negro)."""
    changed = lane_nonzero((nb ^ ob) | (ng ^ og) | (nr ^ o_r), c)
    cand = lane_max(oa, lane_max(nb, lane_max(ng, nr, c), c), c) & lane_nonzero(nb | ng | nr, c)
    return oa ^ ((oa ^ cand) & changed)


# ---------------------------------------------------------------------------
# Comunicación con mpv (socket IPC), sin bloquear
# ---------------------------------------------------------------------------

def ipc_call(path, command, callback=None, timeout_ms=1000):
    """Envía una orden a mpv y llama a callback(data, ok); ok es False si
    falla o si no hay respuesta a tiempo."""
    state = {"done": False, "watch": 0, "timer": 0, "sock": None, "buf": b""}

    def finish(data, ok, from_watch=False, from_timer=False):
        if state["done"]:
            return
        state["done"] = True
        if state["watch"] and not from_watch:
            GLib.source_remove(state["watch"])
        if state["timer"] and not from_timer:
            GLib.source_remove(state["timer"])
        if state["sock"] is not None:
            try:
                state["sock"].close()
            except OSError:
                pass
        if callback:
            callback(data, ok)

    def fail_later():
        # nunca se llama a callback antes de volver: quien llama no tiene
        # que contar con que su respuesta llegue «por dentro» de la llamada
        GLib.timeout_add(0, lambda: finish(None, False) and False)

    if not path:
        fail_later()
        return
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        state["sock"] = s
        s.setblocking(False)
        s.connect(path)
        s.send(json.dumps({"command": command}).encode() + b"\n")
    except OSError:
        fail_later()
        return

    def readable(fd, cond):
        chunk = b""
        if cond & GLib.IO_IN:
            try:
                chunk = s.recv(65536)
            except BlockingIOError:
                return True
            except OSError:
                chunk = b""
        if not chunk:
            finish(None, False, from_watch=True)
            return False
        state["buf"] += chunk
        while b"\n" in state["buf"]:
            line, state["buf"] = state["buf"].split(b"\n", 1)
            try:
                msg = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            if isinstance(msg, dict) and "error" in msg:   # la respuesta (lo demás son eventos)
                ok = msg["error"] == "success"
                finish(msg.get("data") if ok else None, ok, from_watch=True)
                return False
        return True

    def timed_out():
        finish(None, False, from_timer=True)
        return False

    state["watch"] = GLib.io_add_watch(s.fileno(), GLib.PRIORITY_DEFAULT,
                                       GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, readable)
    state["timer"] = GLib.timeout_add(timeout_ms, timed_out)


# ---------------------------------------------------------------------------
# Un monitor: su ventana, su mpv y su máscara de iconos
# ---------------------------------------------------------------------------

class Monitor:
    __slots__ = ("name", "x", "y", "w", "h")

    def __init__(self, name, x, y, w, h):
        self.name, self.x, self.y, self.w, self.h = name, x, y, w, h

    @property
    def rect(self):
        return (self.x, self.y, self.w, self.h)


class Player:
    def __init__(self, daemon, mon):
        self.dm = daemon
        self.mon = mon
        self.win = None           # ventana X donde pinta mpv
        self.token = None
        self.mpv = None           # proceso mpv
        self.socket = None        # su socket IPC
        self.gen = 0              # cambia en cada arranque de mpv (descarta respuestas viejas)
        self.shown = False        # la ventana ya está en pantalla
        self.settled = False
        self.failed = False       # mpv ha fallado demasiadas veces
        self.paused = None
        self.asleep = False       # mpv cerrado porque el escritorio sigue tapado
        self.resume_pos = 0.0
        self.sleep_timer = 0
        self.hwdec = "no"         # método de decodificación elegido para este vídeo
        self.hwdec_tried = False
        self.restart_times = []
        self.healthy = False
        self.failures = 0
        self.mpv_started = 0.0
        self.ram_baseline = 0
        # máscara: mapa de bits con «1» donde se ve el vídeo y «0» donde hay icono
        self.stride = ((mon.w + 31) // 32) * 4
        self.pixmap = None
        self.gc = None
        self.rows = None          # copia local del mapa de bits
        self.visible = None       # píxeles con vídeo (bits a 1) de la copia local
        self.sigs = {}            # fila inicial de cada franja -> firma de su última captura
        self.mask = None          # None (sin poner) | "full" (sin recortes) | "masked"
        self.dirty = None         # filas (y0, y1) pendientes de recalcular
        self.stale = False        # hay recortes que quitar cuando mpv vuelva a pintar
        # capa de iconos (con compositor): ventana ARGB encima de la del vídeo
        self.ov = None
        self.ov_gc = None
        self.argb = None          # su contenido: color premultiplicado + α por píxel
        self.asigs = {}           # franja -> firma de la última captura en negro
        self.pending = set()      # franjas cuya transparencia hay que medir
        self.wshots = {}          # franja -> captura con el fondo blanco
        self.retries = 0
        self.base = {}            # franja -> lo de xfdesktop, allí donde otra ventana de escritorio lo tapa
        self.cells = {}           # franja -> tramos horizontales en los que hay algo que pintar
        self.shape_dirty = False
        self.to_paint = []

    # ---------- ventana y proceso mpv ----------

    def start(self):
        dm = self.dm
        self.token = f"{time.monotonic_ns() // 1000}-{dm.next_seq()}"
        self.win = dm.create_video_window(self.mon, self.token)
        dm.own[self.win.id] = self
        if dm.alpha:
            self.make_overlay()
        self.reset_decoder()
        self.launch_mpv(0)

    def reset_decoder(self):
        self.hwdec = "auto-safe" if self.dm.config.get("hwdec") else "no"
        self.hwdec_tried = False

    def launch_mpv(self, start_pos):
        dm = self.dm
        if dm.stopping or not dm.argv or self.win is None or self.mpv is not None:
            return
        self.gen += 1
        self.socket = os.path.join(RUNTIME_DIR, f"mintmotion-{time.monotonic_ns() // 1000}-{dm.next_seq()}.sock")
        argv = [f"--wid={self.win.id}" if a == "--wid=0" else a for a in dm.argv]
        extra = [f"--hwdec={self.hwdec}", f"--input-ipc-server={self.socket}"]
        if start_pos > 0:
            extra.append(f"--start={start_pos:.3f}")
        dd = argv.index("--") if "--" in argv else len(argv)
        argv[dd:dd] = extra
        sp = setpriv_path()
        if sp:
            argv = [sp, "--pdeathsig", "KILL", "--"] + argv
        launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.NONE)
        if dm.config.get("gpu_env"):
            for k, v in nvidia_only_env():
                launcher.setenv(k, v, True)
        try:
            proc = launcher.spawnv(argv)
        except GLib.Error as e:
            log(f"could not launch mpv: {e.message}")
            self.failed = True
            dm.players_changed()
            return
        self.mpv = proc
        self.mpv_started = time.monotonic()
        self.healthy = False
        self.failures = 0
        self.ram_baseline = 0
        self.asleep = False
        sock = self.socket
        proc.wait_async(None, lambda p, res: dm.guard(self._on_mpv_exit, p, sock))
        dm.publish()
        self._wait_frames(self.gen, 0)

    def _on_mpv_exit(self, proc, sock):
        unlink(sock)
        if proc is not self.mpv:
            return  # cierre previsto (dormir, reinicio o parada)
        self.mpv = None
        if self.dm.stopping:
            return
        log(f"mpv exited unexpectedly ({self.mon.name or 'monitor'})")
        self._on_failure()

    def _on_failure(self):
        """Fallo de mpv: se reintenta con límite."""
        dm = self.dm
        now = time.monotonic()
        self.restart_times = [t for t in self.restart_times if now - t < RESTART_WINDOW_S]
        if len(self.restart_times) >= RESTART_LIMIT:
            log("mpv failed several times in a row; giving up")
            self.failed = True
            self.hide()
            dm.players_changed()
            return
        self.restart_times.append(now)
        # la ventana sigue: basta con volver a abrir mpv en el mismo punto
        dm.timeout(1000, self._retry)

    def _retry(self):
        if self.mpv is None and not self.asleep and not self.failed:
            self.launch_mpv(self.resume_pos)

    def kill_mpv(self, done=None):
        """Cierra mpv (SIGTERM y, si no obedece en 3 s, SIGKILL) y llama a «done»."""
        dm = self.dm
        proc = self.mpv
        self.mpv = None
        if proc is None:
            if done:
                done()
            return
        finished = []

        def exited(p, res):
            finished.append(True)
            if done:
                dm.guard(done)

        proc.wait_async(None, exited)
        proc.send_signal(signal.SIGTERM)
        # Temporizador propio: debe cumplirse aunque el supervisor esté parando.
        GLib.timeout_add(3000, lambda: (None if finished else proc.force_exit()) and False)

    def ipc(self, command, callback=None, timeout_ms=1000):
        dm = self.dm
        cb = (lambda data, ok: dm.guard(callback, data, ok)) if callback else None
        ipc_call(self.socket if self.mpv is not None else None, command, cb, timeout_ms)

    def relaunch(self, keep_pos=True):
        """Cierra mpv y lo vuelve a abrir (en el mismo punto, o desde el
        principio si ha cambiado el vídeo)."""
        self.cancel_sleep()
        if self.failed:
            return
        if self.mpv is None:
            if not keep_pos:
                self.resume_pos = 0.0
            if not self.asleep or not keep_pos:
                self.asleep = False
                self.paused = None
                self.launch_mpv(self.resume_pos)
                self.dm.queue_update()
            return
        gen = self.gen

        def reopen():
            if self.dm.stopping or self.mpv is not None or gen != self.gen:
                return
            self.launch_mpv(self.resume_pos)
            self.paused = None   # se reaplica la pausa si hace falta
            self.dm.queue_update()

        def got_pos(pos, ok):
            if gen != self.gen:
                return
            self.resume_pos = float(pos) if keep_pos and isinstance(pos, (int, float)) else 0.0
            self.kill_mpv(reopen)

        if keep_pos:
            self.ipc(["get_property", "time-pos"], got_pos)
        else:
            got_pos(None, False)

    # ---------- vigilancia de mpv ----------

    def check_health(self):
        if self.mpv is None or self.dm.stopping:
            return
        gen = self.gen

        def answer(data, ok):
            if gen != self.gen or self.mpv is None:
                return
            if ok:
                self.failures = 0
                if not self.healthy:
                    self.healthy = True
                    self.check_hwdec()
                return
            if not self.healthy:
                hung = time.monotonic() - self.mpv_started > STARTUP_TIMEOUT_S
            else:
                self.failures += 1
                hung = self.failures >= 2
            if hung:
                log("mpv is not responding; restarting it")
                self.kill_mpv(self._on_failure)

        self.ipc(["get_property", "pid"], answer)

    def check_hwdec(self):
        """Si mpv decodifica por hardware copiando cada fotograma a la RAM y
        hay un modo directo, se prueba el directo una vez; si no funciona, se
        vuelve."""
        if self.hwdec == "no":
            return
        gen = self.gen

        def answer(cur, ok):
            if gen != self.gen or not ok or not isinstance(cur, str):
                return
            if not self.hwdec_tried and cur.endswith("-copy"):
                self.hwdec_tried = True
                self.hwdec = cur[:-5]
                log(f"decoding with {cur}: trying the direct mode {self.hwdec}")
                self.relaunch()
            elif self.hwdec_tried and self.hwdec != "auto-safe" and cur in ("no", ""):
                log(f"direct mode {self.hwdec} does not work; going back to auto-safe")
                self.hwdec = "auto-safe"
                self.relaunch()

        self.ipc(["get_property", "hwdec-current"], answer)

    def check_ram(self):
        cfg = self.dm.config
        if self.mpv is None or not self.healthy or not cfg.get("ram_watchdog") or self.dm.stopping:
            return
        try:
            pid = int(self.mpv.get_identifier())
        except (TypeError, ValueError):
            return
        pss = process_pss_kb(pid)
        if not pss:
            return
        try:
            fixed = float(cfg.get("ram_limit_mb") or 0)
        except (TypeError, ValueError):
            fixed = 0
        if fixed > 0:
            limit = fixed * 1024
        else:
            if not self.ram_baseline:
                if time.monotonic() - self.mpv_started >= RAM_BASELINE_AFTER_S:
                    self.ram_baseline = pss
                return
            limit = max(self.ram_baseline * RAM_FACTOR, self.ram_baseline + RAM_MIN_GROWTH_KB)
        if pss > limit:
            log(f"mpv uses {round(pss / 1024)} MB (limit {round(limit / 1024)} MB): restarting it")
            self.relaunch()

    # ---------- mostrar la ventana ----------

    def _wait_frames(self, gen, tries):
        """Espera a que mpv ya pinte. La primera vez se muestra entonces la
        ventana (no tiene fondo y, hasta el primer fotograma, su contenido no
        está definido); las siguientes se rehace la máscara aplazada."""
        if gen != self.gen or self.mpv is None or self.dm.stopping:
            return
        if self.shown and not self.stale:
            return

        def answer(n, ok):
            if gen != self.gen or self.mpv is None or self.dm.stopping:
                return
            if (ok and isinstance(n, (int, float)) and n > 1) or tries >= 50:
                if not self.shown:
                    self.reveal()
                elif self.stale:
                    self.stale = False
                    self.mark_dirty(0, self.mon.h)
            else:
                self.dm.timeout(200, self._wait_frames, gen, tries + 1)

        self.ipc(["get_property", "estimated-frame-number"], answer, 500)

    def reveal(self):
        dm = self.dm
        self.shown = True
        self.failed = False
        self.mask = None
        self.dirty = (0, self.mon.h)
        self.update_mask()
        self.win.map()
        if self.ov is not None:
            self.ov.map()
        dm.timeout(250, self.settle)   # por si no llega ReparentNotify (sin gestor de ventanas)
        self.paused = None
        dm.players_changed()

    def settle(self):
        """Tras gestionar la ventana, xfwm4 solo aplica la región de entrada
        vacía a su marco si se la vuelven a poner. Además se baja al fondo de
        su capa: por encima del escritorio, pero por debajo de otras ventanas
        «siempre debajo» (conky y similares)."""
        if self.win is None or not self.shown:
            return
        if self.ov is not None:
            # primero la capa de iconos y después el vídeo: el vídeo queda al
            # fondo de la capa «below» y los iconos justo encima
            self.ov.shape_rectangles(shape.SO.Set, shape.SK.Input, X.Unsorted, 0, 0, [])
            self.shape_dirty = True
            self.update_shape()
            self.ov.configure(stack_mode=X.Below)
        self.win.shape_rectangles(shape.SO.Set, shape.SK.Input, X.Unsorted, 0, 0, [])
        self.win.configure(stack_mode=X.Below)
        self.settled = True

    def hide(self):
        if self.win is not None and self.shown:
            self.win.unmap()
            if self.ov is not None:
                self.ov.unmap()
        self.shown = False
        self.settled = False
        self.mask = None

    # ---------- pausa y reposo ----------

    def set_pause(self, pause):
        if not self.shown or self.failed:
            return
        if pause == self.paused:
            return
        self.paused = pause
        if pause:
            if self.mpv is not None:
                self.ipc(["set_property", "pause", True])
            self.schedule_sleep()
        else:
            self.cancel_sleep()
            if self.asleep:
                # La ventana sigue mostrando el último fotograma: se vuelve a
                # abrir mpv justo donde se quedó.
                self.launch_mpv(self.resume_pos)
            elif self.mpv is not None:
                def answer(data, ok):
                    if not ok:
                        self.paused = None   # se reintenta en la próxima revisión
                self.ipc(["set_property", "pause", False], answer)

    def schedule_sleep(self):
        """Escritorio tapado durante «sleep_after» segundos: se cierra mpv y
        se libera toda su memoria."""
        try:
            secs = float(self.dm.config.get("sleep_after") or 0)
        except (TypeError, ValueError):
            secs = 0
        if secs <= 0 or self.sleep_timer or self.asleep or self.mpv is None:
            return
        self.sleep_timer = self.dm.timeout(int(secs * 1000), self._sleep_now)

    def _sleep_now(self):
        self.sleep_timer = 0
        if not self.paused or self.mpv is None or self.dm.stopping:
            return
        gen = self.gen

        def got_pos(pos, ok):
            if gen != self.gen or not self.paused or self.mpv is None or self.dm.stopping:
                return
            self.resume_pos = float(pos) if isinstance(pos, (int, float)) else 0.0
            self.asleep = True
            self.kill_mpv(None)
            self.dm.publish()

        self.ipc(["get_property", "time-pos"], got_pos)

    def cancel_sleep(self):
        if self.sleep_timer:
            self.dm.cancel(self.sleep_timer)
            self.sleep_timer = 0

    def state(self):
        if self.failed:
            return "error"
        if not self.shown:
            return "arrancando"
        if self.asleep:
            return "dormido"
        if self.paused:
            return "pausado"
        return "reproduciendo"

    # ---------- máscara de iconos ----------

    def mark_dirty(self, y0, y1):
        y0, y1 = max(0, y0), min(self.mon.h, y1)
        if y1 <= y0:
            return
        if self.dirty:
            y0, y1 = min(y0, self.dirty[0]), max(y1, self.dirty[1])
        self.dirty = (y0, y1)
        self.dm.schedule_masks()

    def _set_full(self):
        if self.mask != "full":
            self.win.shape_mask(shape.SO.Set, shape.SK.Bounding, 0, 0, X.NONE)
            self.mask = "full"

    def update_mask(self):
        """Recalcula las filas pendientes de la máscara y recorta la ventana."""
        dm = self.dm
        band, self.dirty = self.dirty, None
        if self.win is None or not self.shown or band is None:
            return
        if self.ov is not None:
            self._set_full()
            self.update_alpha(band)
            return
        m = self.mon
        desks = [dw for dw in dm.desks.values() if dw.overlaps(m)]
        if not dm.can_mask or not desks or dm.hiding:
            self._set_full()
            return
        if self.pixmap is None:
            self.pixmap = self.win.create_pixmap(m.w, m.h, 1)
            self.gc = self.pixmap.create_gc(foreground=0, background=0)
            self.pixmap.fill_rectangle(self.gc, 0, 0, m.w, m.h)
            self.rows = bytearray(self.stride * m.h)
        y0 = band[0] - band[0] % STRIP_ROWS
        y1 = min(m.h, -(-band[1] // STRIP_ROWS) * STRIP_ROWS)
        pad = self.stride * 8 - m.w
        only_shrink = self.mpv is None     # nadie repintaría lo que se destape
        changed = False
        t0 = time.monotonic()
        for y in range(y0, y1, STRIP_ROWS):
            rows = min(STRIP_ROWS, m.h - y)
            shots = [dw.capture(m, y, rows) for dw in desks]
            # xfdesktop se repinta entero a menudo (al cambiar el foco, por
            # ejemplo) sin que cambie nada: si la franja es idéntica a la de
            # la vez anterior, no hay nada que calcular.
            sig = tuple(None if sh is None else (sh[0], sh[1], sh[2], sh[3], hash(sh[4])) for sh in shots)
            if self.sigs.get(y) == sig:
                continue
            self.sigs[y] = sig
            bits = None
            for shot in shots:
                if shot is not None:
                    part = DesktopWindow.key_bits(dm, m, y, rows, shot)
                    bits = part if bits is None else and_bits(bits, part)
            del shots
            if bits is None:
                bits = b"1" * (m.w * rows)
            packed = pack_bits(bits, m.w, rows, pad, dm.lsb_first)
            a, b = y * self.stride, (y + rows) * self.stride
            old = bytes(self.rows[a:b])
            if only_shrink and packed != old:
                shrunk = (int.from_bytes(packed, "little") & int.from_bytes(old, "little")) \
                    .to_bytes(len(old), "little")
                if shrunk != packed:
                    self.stale = True
                    self.sigs.pop(y, None)   # hay que rehacerla cuando mpv vuelva a pintar
                packed = shrunk
            if packed != old:
                self.rows[a:b] = packed
                self.pixmap.put_image(self.gc, 0, y, m.w, rows, X.ZPixmap, 1, 0, packed)
                changed = True
        if changed or self.visible is None:
            self.visible = bin(int.from_bytes(self.rows, "little")).count("1")
        debug(f"mask {m.name}: rows {y0}-{y1} changed={changed} visible={self.visible}/{m.w * m.h} "
              f"in {(time.monotonic() - t0) * 1000:.0f} ms")
        if self.visible < MIN_VISIBLE * m.w * m.h:
            # El fondo de xfdesktop no es la llave (aún no se ha repintado, o
            # no se ha podido cambiar): el vídeo se ve entero, sin iconos.
            self._set_full()
        elif changed or self.mask != "masked":
            self.win.shape_mask(shape.SO.Set, shape.SK.Bounding, 0, 0, self.pixmap)
            self.mask = "masked"

    # ---------- capa de iconos con transparencia real ----------

    def make_overlay(self):
        dm = self.dm
        m = self.mon
        if self.ov is not None or self.win is None:
            return
        self.ov = dm.create_overlay_window(m, self.token)
        dm.own[self.ov.id] = self
        self.ov_gc = self.ov.create_gc()
        self.argb = bytearray(m.w * m.h * 4)
        self.asigs, self.pending, self.wshots, self.retries = {}, set(), {}, 0
        self.base, self.cells, self.to_paint = {}, {}, []
        self.sigs = {}
        # de momento no ocupa nada: se le da forma según aparecen los iconos
        self.shape_dirty = True
        self.update_shape()
        if self.shown:
            self.mask = None
            self._set_full()
            self.ov.map()
            dm.timeout(250, self.settle)
            self.mark_dirty(0, m.h)

    def drop_overlay(self):
        ov, self.ov = self.ov, None
        if ov is None:
            return
        self.dm.own.pop(ov.id, None)
        self.dm.frames.pop(ov.id, None)
        self.ov_gc = self.argb = None
        self.asigs, self.pending, self.wshots = {}, set(), {}
        self.base, self.cells, self.to_paint = {}, {}, []
        if self.dm.x_ok:
            ov.destroy()

    def paint(self, y, rows):
        """Lleva a la ventana las filas [y, y + rows) de la capa de iconos."""
        if self.ov is None or not self.shown:
            return
        w = self.mon.w
        y, end = max(0, y), min(self.mon.h, y + rows)
        step = max(1, PUT_BYTES // (w * 4))
        for yy in range(y, end, step):
            n = min(step, end - yy)
            self.ov.put_image(self.ov_gc, 0, yy, w, n, X.ZPixmap, 32, 0,
                              bytes(self.argb[yy * w * 4:(yy + n) * w * 4]))

    def update_shape(self):
        """La ventana de los iconos solo ocupa las celdas donde hay algo: así
        el compositor no tiene que mezclar una capa del tamaño de la pantalla
        con cada fotograma del vídeo."""
        if not self.shape_dirty or self.ov is None:
            return
        self.shape_dirty = False
        rects = []
        for y in sorted(self.cells):
            rows = self._strip_rows(y)
            rects += [(x0, y, x1 - x0, rows) for x0, x1 in self.cells[y]]
        self.ov.shape_rectangles(shape.SO.Set, shape.SK.Bounding, X.Unsorted, 0, 0, rects)

    def flush(self):
        """Primero la forma (lo que se pinta fuera de ella se pierde) y después el contenido."""
        self.update_shape()
        todo, self.to_paint = self.to_paint, []
        for y, rows in todo:
            self.paint(y, rows)

    def _strip_rows(self, y):
        return min(STRIP_ROWS, self.mon.h - y)

    def _strips(self, band):
        y0 = band[0] - band[0] % STRIP_ROWS
        y1 = min(self.mon.h, -(-band[1] // STRIP_ROWS) * STRIP_ROWS)
        return range(y0, y1, STRIP_ROWS)

    def update_alpha(self, band):
        """Las ventanas de escritorio han repintado: se actualizan las franjas
        que hayan cambiado (con una transparencia provisional) y se pide medirla."""
        dm = self.dm
        m = self.mon
        if dm.phase or dm.hiding:
            # midiendo (el fondo puede estar en blanco) o cerrando: después
            if not dm.hiding:
                self.dirty = band if self.dirty is None else \
                    (min(band[0], self.dirty[0]), max(band[1], self.dirty[1]))
            return
        has_keyed = any(dw.keyed and dw.overlaps(m) for dw in dm.desks.values())
        if has_keyed and not dm.keyed():
            return   # xfdesktop aún no muestra el color llave; avisará al repintar
        if not has_keyed:
            self.pending = set()
        t0 = time.monotonic()
        n = 0
        for y in self._strips(band):
            rows = self._strip_rows(y)
            raw = dm.capture_strip(m, y, rows, 0) if has_keyed else None
            if has_keyed and raw is None:
                continue   # no se ha podido leer: se queda como estaba
            fshots = dm.capture_foreign(m, y, rows)
            sig = (None if raw is None else hash(bytes(raw)),
                   tuple((f[0], f[1], f[2], f[3], hash(f[4])) for f in fshots))
            old = self.asigs.get(y)
            if old == sig:
                # xfdesktop se repinta entero a menudo sin que cambie nada
                continue
            kchanged = old is None or old[0] != sig[0]
            self.asigs[y] = sig
            self._apply(y, rows, raw, None, fshots, kchanged)
            if kchanged and raw is not None:
                self.pending.add(y)   # solo lo de xfdesktop necesita medirse
            n += 1
        self.flush()
        if n:
            debug(f"icons {m.name}: {n} strips changed in {(time.monotonic() - t0) * 1000:.0f} ms")
        if self.pending:
            dm.request_refine()

    def _apply(self, y, rows, raw, white, fshots, kchanged=True):
        """Nueva franja de la capa: «raw» es lo que pinta xfdesktop sobre
        negro; «white», lo mismo sobre blanco (si se está midiendo); «fshots»,
        lo que pintan encima otras ventanas de escritorio."""
        m = self.mon
        n = m.w * rows
        a, b = y * m.w * 4, (y + rows) * m.w * 4
        cur = self.argb[a:b]
        base_old = self.base.get(y, cur)
        if raw is None:
            base_new = bytearray(n * 4)
        elif white is None and not kchanged:
            base_new = base_old
        else:
            c = self.dm.lanes.consts(n)
            load = Lanes.load
            nb, ng, nr = load(raw[0::4]), load(raw[1::4]), load(raw[2::4])
            if white is not None:
                alpha = alpha_exact(nb, ng, nr, load(white[0::4]), load(white[1::4]), load(white[2::4]), c)
            else:
                alpha = alpha_provisional(nb, ng, nr, load(base_old[0::4]), load(base_old[1::4]),
                                          load(base_old[2::4]), load(base_old[3::4]), c)
            base_new = raw
            base_new[3::4] = Lanes.store(alpha, n)
        if fshots:
            self.base[y] = base_new
            shown = self._paste_foreign(bytearray(base_new), y, fshots)
        else:
            self.base.pop(y, None)
            shown = base_new
        if shown != cur:
            self.argb[a:b] = shown
            self.to_paint.append((y, rows))
            self._update_cells(y, rows, shown)

    def _paste_foreign(self, buf, y, fshots):
        """Otras ventanas de escritorio (conky y similares) van encima de lo
        de xfdesktop. Las de 32 bits traen su propia transparencia; en las
        demás, el negro (el fondo de xfdesktop que copian las que se hacen
        pasar por transparentes) deja ver el vídeo."""
        m = self.mon
        for ix0, iy0, iw, ih, fraw, depth in fshots:
            for r in range(ih):
                seg = fraw[r * iw * 4:(r + 1) * iw * 4]
                if depth == 32:
                    fa = seg[3::4]
                else:
                    v = int.from_bytes(seg[0::4], "little") | int.from_bytes(seg[1::4], "little") | \
                        int.from_bytes(seg[2::4], "little")
                    fa = v.to_bytes(iw, "little").translate(_NONZERO_TO_FF)
                    seg = bytearray(seg)
                    seg[3::4] = fa
                zeros = fa.count(0)
                if zeros == iw:
                    continue
                o = ((iy0 - m.y - y + r) * m.w + ix0 - m.x) * 4
                if zeros == 0:
                    buf[o:o + iw * 4] = seg
                    continue
                nz = fa.translate(_NONZERO_TO_FF)
                mk = bytearray(iw * 4)
                mk[0::4] = mk[1::4] = mk[2::4] = mk[3::4] = nz
                mi = int.from_bytes(mk, "little")
                old = int.from_bytes(buf[o:o + iw * 4], "little")
                buf[o:o + iw * 4] = (old ^ ((old ^ int.from_bytes(seg, "little")) & mi)).to_bytes(iw * 4, "little")
        return buf

    def _update_cells(self, y, rows, shown):
        """Tramos horizontales de la franja en los que algún píxel no es transparente."""
        w = self.mon.w
        ap = bytes(shown[3::4])
        runs = []
        if ap.count(0) != len(ap):
            col = 0
            for r in range(rows):
                col |= int.from_bytes(ap[r * w:(r + 1) * w], "little")
            cb = col.to_bytes(w, "little")
            for x in range(0, w, CELL):
                x1 = min(w, x + CELL)
                if cb.count(0, x, x1) != x1 - x:
                    if runs and runs[-1][1] == x:
                        runs[-1][1] = x1
                    else:
                        runs.append([x, x1])
        runs = tuple((x0, x1) for x0, x1 in runs)
        if self.cells.get(y, ()) != runs:
            self.cells[y] = runs
            self.shape_dirty = True

    def capture_white(self):
        dm = self.dm
        self.wshots = {y: dm.capture_strip(self.mon, y, self._strip_rows(y), 255)
                       for y in sorted(self.pending)}

    def finish_refine(self):
        """El fondo vuelve a estar en negro: con la captura en blanco de antes
        y una nueva en negro sale la transparencia exacta de cada franja."""
        dm = self.dm
        ws, self.wshots = self.wshots, {}
        again = set()
        for y, white in ws.items():
            rows = self._strip_rows(y)
            raw = dm.capture_strip(self.mon, y, rows, 0)
            if raw is None or white is None or len(white) != len(raw):
                continue
            fshots = dm.capture_foreign(self.mon, y, rows)
            sig = (hash(bytes(raw)), tuple((f[0], f[1], f[2], f[3], hash(f[4])) for f in fshots))
            old = self.asigs.get(y)
            if old is None or old[0] != sig[0]:
                again.add(y)     # cambió mientras se medía: se repite
            self.asigs[y] = sig
            self._apply(y, rows, raw, white, fshots)
        self.flush()
        if again and self.retries < REFINE_RETRIES:
            self.retries += 1
            self.pending = again
        else:
            self.retries = 0
            self.pending = set()

    # ---------- cierre ----------

    def destroy(self):
        dm = self.dm
        self.gen += 1
        self.cancel_sleep()
        win, self.win = self.win, None
        if win is None:
            return
        self.drop_overlay()
        dm.own.pop(win.id, None)
        dm.frames.pop(win.id, None)
        if self.shown:
            win.unmap()
        self.shown = False
        pixmap, gc, self.pixmap, self.gc, self.rows = self.pixmap, self.gc, None, None, None
        self.visible = None
        self.sigs = {}

        def gone():
            # la ventana se destruye cuando mpv ya no pinta en ella
            if dm.x_ok:
                if gc is not None:
                    gc.free()
                if pixmap is not None:
                    pixmap.free()
                win.destroy()

        self.kill_mpv(gone)


class DesktopWindow:
    """Ventana de tipo escritorio de otro programa (xfdesktop): lo que pinte
    distinto del color llave tiene que verse por encima del vídeo."""

    def __init__(self, win):
        self.win = win
        self.damage = None
        self.rect = None      # (x, y, w, h) en coordenadas de la pantalla
        self.keyed = True     # es de xfdesktop: su fondo es el color llave
        self.depth = 24

    def overlaps(self, m):
        if not self.rect:
            return False
        x, y, w, h = self.rect
        return x < m.x + m.w and x + w > m.x and y < m.y + m.h and y + h > m.y

    def capture(self, m, y, rows):
        """Píxeles de esta ventana en la franja [y, y + rows) del monitor m:
        (x0, y0, ancho, alto, datos) en coordenadas de pantalla, o None si no
        la toca o no se puede leer."""
        x, wy, w, h = self.rect
        ix0, ix1 = max(m.x, x), min(m.x + m.w, x + w)
        iy0, iy1 = max(m.y + y, wy), min(m.y + y + rows, wy + h)
        if ix1 <= ix0 or iy1 <= iy0:
            return None
        iw, ih = ix1 - ix0, iy1 - iy0
        try:
            raw = self.win.get_image(ix0 - x, iy0 - wy, iw, ih, X.ZPixmap, 0xffffffff).data
        except xerror.XError:
            return None
        if len(raw) != iw * ih * 4:
            return None
        return (ix0, iy0, iw, ih, raw)

    @staticmethod
    def key_bits(dm, m, y, rows, shot):
        """Cadena de «1»/«0» de la franja: «1» donde la captura muestra la
        llave o no llega."""
        ix0, iy0, iw, ih, raw = shot
        ix1, iy1 = ix0 + iw, iy0 + ih
        bits = dm.matcher.bits(raw, iw * ih)
        if iw == m.w and ih == rows:
            return bits
        left, right = b"1" * (ix0 - m.x), b"1" * (m.x + m.w - ix1)
        full = b"1" * m.w
        out = [full] * (iy0 - (m.y + y))
        out += [left + bits[r * iw:(r + 1) * iw] + right for r in range(ih)]
        out += [full] * (m.y + y + rows - iy1)
        return b"".join(out)


class WinInfo:
    """Lo que hace falta saber de una ventana gestionada para decidir si
    tapa el escritorio. Se relee solo cuando cambia alguna propiedad."""
    __slots__ = ("win", "type", "state", "desktop", "opacity", "strut", "gtk", "dirty")

    def __init__(self, win):
        self.win = win
        self.type = None
        self.state = frozenset()
        self.desktop = None
        self.opacity = 0xFFFFFFFF
        self.strut = None
        self.gtk = None
        self.dirty = True


